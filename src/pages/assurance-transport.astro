---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import ConversionActions from '../components/ConversionActions.astro';
import CoverageMap from '../components/CoverageMap.astro';
import FAQ from '../components/FAQ.astro';
import PageCTA from '../components/PageCTA.astro';
import PageHero from '../components/PageHero.astro';
import ProcessDiagram from '../components/ProcessDiagram.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import RelatedResources from '../components/RelatedResources.astro';
import SectionIllustration from '../components/SectionIllustration.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SolutionMethod from '../components/SolutionMethod.astro';
import RiskMap from '../components/RiskMap.astro';
import TimelineDiagram from '../components/TimelineDiagram.astro';
import TrustBar from '../components/TrustBar.astro';
import WhatWeAnalyze from '../components/WhatWeAnalyze.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { baseSchemas, breadcrumbSchema, pageUrl, serviceSchema } from '../data/seo';

const path = '/assurance-transport/';
const description = 'Assurance transport et logistique : audit des responsabilités, flottes, marchandises, entrepôts, sous-traitance et sinistralité.';
const contactHref = '/?besoin=assurance-transport&intent=quote&product=assurance-transport#contact';
const ctaLabel = 'Démarrer ma demande de devis Transport';
const auditHref = '/?besoin=audit-assurances-entreprise&intent=audit&product=assurance-transport#contact';
const auditLabel = 'Faire analyser mon programme transport';
const transportImageRoot = '/images/transport';
const transportAssetExists = (publicPath: string) => existsSync(fileURLToPath(new URL(`../../public${publicPath}`, import.meta.url)));
const prepareTransportVisual = (baseName: string, widths: number[], masterWidth: number, sizes: string) => {
  const variants = (format: 'avif' | 'webp') => [
    ...widths.map((width) => `${transportImageRoot}/${baseName}-${width}.${format}`),
    `${transportImageRoot}/${baseName}.${format}`,
  ];
  const avifFiles = variants('avif');
  const webpFiles = variants('webp');
  const ready = [...avifFiles, ...webpFiles].every(transportAssetExists);
  const srcset = (files: string[]) => files
    .map((file, index) => `${file} ${index < widths.length ? widths[index] : masterWidth}w`)
    .join(', ');

  return {
    image: ready ? `${transportImageRoot}/${baseName}.webp` : undefined,
    responsive: {
      avifSrcset: srcset(avifFiles),
      webpSrcset: srcset(webpFiles),
      sizes,
    },
  };
};
const transportVisuals = {
  hero: prepareTransportVisual('hero-transport-logistique', [960, 1280, 1600, 2000], 3200, '(max-width: 768px) 100vw, (max-width: 1280px) 44vw, 576px'),
  audit: prepareTransportVisual('audit-transport-entrepot', [640, 960, 1280, 1600], 2400, '(max-width: 768px) 100vw, 1180px'),
  method: prepareTransportVisual('methode-transport-analyse-documentaire', [640, 960, 1280, 1600], 2400, '(max-width: 768px) 100vw, 1180px'),
  texture: prepareTransportVisual('texture-transport-logistique', [768, 1280, 1600], 2520, '(max-width: 768px) 100vw, 1180px'),
};
const auditProcess = [
  { label: 'Découverte', icon: 'activity' as const },
  { label: 'Analyse de l’activité', icon: 'activity' as const },
  { label: 'Étude des contrats', icon: 'document' as const },
  { label: 'Identification des écarts', icon: 'search' as const },
  { label: 'Consultation du marché', note: 'Si pertinente', icon: 'market' as const },
  { label: 'Recommandations', icon: 'recommendation' as const },
  { label: 'Accompagnement', icon: 'support' as const },
];
const transportRisks = [
  { label: 'Flotte automobile', icon: 'vehicle' as const },
  { label: 'Marchandises transportées', icon: 'goods' as const },
  { label: 'RC professionnelle', icon: 'shield' as const },
  { label: 'RC exploitation', icon: 'shield' as const },
  { label: 'Conducteurs', icon: 'people' as const },
  { label: 'Sous-traitance', icon: 'network' as const },
  { label: 'International', icon: 'globe' as const },
  { label: 'Cyber', icon: 'cyber' as const },
  { label: 'Continuité d’activité', icon: 'continuity' as const },
];
const coverageStages = [
  { label: 'Entreprise' },
  { label: 'Activité' },
  { label: 'Risques' },
  { label: 'Garanties', items: ['RC professionnelle', 'RC exploitation', 'Flotte automobile', 'Assurance marchandises', 'Protection juridique', 'Cyber'] },
  { label: 'Contrats' },
];
const auditTimeline = [
  { label: 'Prise de contact', icon: 'activity' as const },
  { label: 'Collecte documentaire', icon: 'document' as const },
  { label: 'Analyse', icon: 'search' as const },
  { label: 'Échanges', icon: 'people' as const },
  { label: 'Consultation éventuelle du marché', icon: 'market' as const, optional: true },
  { label: 'Restitution', icon: 'recommendation' as const },
  { label: 'Accompagnement', icon: 'support' as const },
];
const faqItems = [
  { question: 'Quels métiers sont concernés ?', answer: 'Le transport routier de marchandises, la commission de transport, la logistique, l’exploitation d’entrepôts, le déménagement, le convoyage et les entreprises disposant d’une flotte significative peuvent être concernés.' },
  { question: 'La flotte suffit-elle à couvrir une activité de transport ?', answer: 'Non. Les véhicules ne traitent pas à eux seuls les responsabilités du transporteur, les marchandises confiées, le stockage, la sous-traitance ou l’interruption d’activité.' },
  { question: 'Quelles informations préparer avant une consultation ?', answer: 'La composition du parc, les flux, les marchandises, les valeurs, les zones, la sous-traitance, les donneurs d’ordre et la sinistralité permettent de présenter le risque avec plus de précision.' },
];
const structuredData = [
  ...baseSchemas,
  breadcrumbSchema([{ name: 'Accueil', path: '/' }, { name: 'Assurance transport', path }]),
  serviceSchema('Conseil en assurance transport et logistique', description, path),
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
];
---

<SiteLayout title="Assurance transport et logistique | Assuromieux Paris" {description} canonical={pageUrl(path)} currentPath={path} ctaHref={contactHref} {ctaLabel} {structuredData}>
  <main id="contenu-principal">
    <PageHero
      eyebrow="Expertise sectorielle"
      title="Analyser l’ensemble de la chaîne transport et logistique."
      lead="Nous rapprochons véhicules, marchandises, responsabilités, stockage et sous-traitance pour sécuriser les arbitrages qui comptent dans votre exploitation."
      breadcrumbs={[{ href: '/', label: 'Accueil' }, { label: 'Assurance transport' }]}
    >
      <ConversionActions primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} density="hero" analyticsLocation="hero" analyticsSource="transport_hero" />
      <SectionIllustration
        slot="visual"
        image={transportVisuals.hero.image}
        responsive={transportVisuals.hero.responsive}
        alt="Flotte de poids lourds stationnée sur une plateforme logistique contemporaine."
        ratio="16:9"
        width={3200}
        height={1800}
        filename="hero-transport-logistique.webp"
        imageType="Flotte récente, plateforme logistique, perspective large"
        priority
        overlay="brand"
        position="58% 50%"
      />
    </PageHero>
    <TrustBar />

    <section class="section" aria-labelledby="public-title">
      <div class="container-wide content-grid">
        <div class="content-copy">
          <p class="eyebrow">À qui s’adresse cette expertise ?</p>
          <h2 id="public-title">Aux entreprises qui déplacent, stockent ou confient des marchandises.</h2>
        </div>
        <div class="content-copy">
          <p>L’approche concerne notamment les transporteurs routiers, logisticiens, commissionnaires, exploitants d’entrepôts, déménageurs et convoyeurs.</p>
          <p>Elle s’adapte aussi aux entreprises dont la flotte ou les flux sont devenus un enjeu majeur, sans faire du transport le seul positionnement du cabinet.</p>
        </div>
      </div>
    </section>

    <section class="section section--surface transport-verticals" aria-labelledby="transport-verticals-title">
      <div class="container-wide transport-verticals__layout">
        <header>
          <p class="eyebrow">Expertises métier</p>
          <h2 id="transport-verticals-title">Trois activités, trois chaînes de risques distinctes.</h2>
          <p>Ces pages partent de l’exploitation. Elles complètent cette vue générale sans répéter les pages produits.</p>
        </header>
        <ol>
          {[
            ['/secteurs/transport-routier-marchandises/', 'Transport routier de marchandises', 'Responsabilité du transporteur, marchandises, flotte, sous-traitance et sites.'],
            ['/secteurs/convoyage-vehicules/', 'Convoyage de véhicules', 'Véhicule confié, circulation, mission, conducteur et restitution.'],
            ['/secteurs/demenagement/', 'Déménagement', 'Biens confiés, manutention, transport, stockage et continuité.'],
          ].map(([href, title, text], index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3><a href={href}>{title}</a></h3><p>{text}</p></div><a href={href} aria-label={`Découvrir ${title}`}>Découvrir <i aria-hidden="true">→</i></a></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="transport-roles-title">
      <div class="container-wide content-grid">
        <div class="content-copy">
          <p class="eyebrow">Rôle contractuel</p>
          <h2 id="transport-roles-title">Transporteur, commissionnaire et marchandises : identifier le rôle exercé</h2>
        </div>
        <div class="content-copy">
          <p>Le transporteur exécute matériellement le déplacement des marchandises.</p>
          <p>Le commissionnaire organise le transport en son nom et sous sa responsabilité, selon le cadre applicable à la mission. Cette qualification doit être vérifiée à partir des opérations et des engagements contractuels réels.</p>
          <p>Une entreprise peut également avoir besoin de protéger les marchandises indépendamment de la seule responsabilité du transporteur.</p>
          <p>Les contrats à examiner dépendent donc du rôle contractuel, des marchandises, des flux, des engagements et des limites de responsabilité. Cette présentation générale ne remplace pas l’analyse juridique d’une situation particulière.</p>
        </div>
      </div>
    </section>

    <section id="risques" class="section section--surface" aria-labelledby="risks-title">
      <div class="container-wide">
        <SectionHeader kicker="Risques à coordonner" title="Quatre ensembles à relier." id="risks-title" />
        <div class="feature-grid feature-grid--2">
          {[
            ['Responsabilités', 'Prestations, engagements contractuels, donneurs d’ordre et recours.'],
            ['Flotte et conducteurs', 'Parc, usages, véhicules, franchises et sinistralité.'],
            ['Marchandises et flux', 'Responsabilité sur les marchandises, assurance des biens, valeurs confiées, zones, ruptures de charge et stockage temporaire.'],
            ['Sites et continuité', 'Entrepôts, matériels, sous-traitance et interruption d’activité.'],
          ].map(([title, text]) => <article class="feature-item"><h3>{title}</h3><p>{text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="section" aria-label="Cartographie pédagogique des risques Transport">
      <div class="container-wide">
        <RiskMap title="Les risques d’une entreprise de transport forment un ensemble." description="Cette cartographie permet de visualiser les principaux sujets à rapprocher avant d’examiner les contrats." center="Entreprise de transport" risks={transportRisks} />
      </div>
    </section>

    <section class="section" aria-labelledby="checks-title">
      <div class="container-wide content-grid content-grid--reverse">
        <div class="editorial-panel">
          <h2 id="checks-title">Points à vérifier</h2>
          <ul>
            <li>nature des prestations et responsabilités ;</li>
            <li>parc, conducteurs et usages réels ;</li>
            <li>marchandises, valeurs et zones desservies ;</li>
            <li>stockage, partenaires et sous-traitance ;</li>
            <li>exigences des donneurs d’ordre ;</li>
            <li>fréquence et coût des sinistres.</li>
          </ul>
        </div>
        <div class="content-copy">
          <p class="eyebrow">Présenter le risque</p>
          <h2>Une consultation utile repose sur des données structurées.</h2>
          <p>Le marché doit comprendre l’exploitation, pas seulement recevoir une liste de véhicules. Les flux, les marchandises, les responsabilités et la prévention donnent du sens au dossier.</p>
          <p>Cette préparation aide à comparer les garanties et les conditions sur une base plus cohérente.</p>
        </div>
      </div>
    </section>

    <section class="section section--compact" aria-label="Emplacement du futur visuel d’audit transport">
      <div class="container-wide">
        <SectionIllustration
          image={transportVisuals.audit.image}
          responsive={transportVisuals.audit.responsive}
          alt="Quai logistique en activité avec palettes, remorques et entrepôt en profondeur."
          ratio="4:3"
          width={2400}
          height={1800}
          filename="audit-transport-entrepot.webp"
          imageType="Quai, palettes, remorques et activité réelle"
          loading="lazy"
          overlay="light"
          position="52% 50%"
        />
      </div>
    </section>

    <section class="section section--surface" aria-label="Architecture pédagogique des garanties Transport">
      <div class="container-wide">
        <CoverageMap title="Relier l’activité aux contrats." description="Une lecture cohérente part de l’entreprise et de ses risques avant d’examiner l’architecture des garanties." stages={coverageStages} />
      </div>
    </section>

    <WhatWeAnalyze />

    <section class="section" aria-label="Méthode d’audit Transport en sept étapes">
      <div class="container-wide">
        <ProcessDiagram title="Notre méthode d’audit Transport." description="Sept étapes structurent l’analyse, de la découverte de l’exploitation à l’accompagnement des décisions." steps={auditProcess} />
      </div>
    </section>

    <section class="section section--compact section--surface" aria-label="Emplacement du futur visuel de méthode transport">
      <div class="container-wide">
        <SectionIllustration
          image={transportVisuals.method.image}
          responsive={transportVisuals.method.responsive}
          alt="Analyse de contrats d’assurance transport sur une tablette et des documents de travail."
          ratio="3:2"
          width={2400}
          height={1600}
          filename="methode-transport-analyse-documentaire.webp"
          imageType="Contrats, tablette et documents sur bureau contemporain"
          loading="lazy"
          overlay="light"
          position="50% 54%"
        />
      </div>
    </section>

    <SolutionMethod title="Une méthode commune, adaptée au transport." text="L’analyse sectorielle conserve les quatre temps Assuromieux et accorde une attention particulière aux flux, aux responsabilités et à la sinistralité.">
      <ConversionActions slot="actions" primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} tone="dark" density="compact" analyticsLocation="method" analyticsSource="transport_method" />
    </SolutionMethod>

    <section class="section" aria-label="Déroulement chronologique d’un audit Transport">
      <div class="container-wide">
        <TimelineDiagram title="Le déroulement d’un audit." description="Le rythme s’adapte aux informations disponibles et à la pertinence d’une éventuelle consultation du marché." events={auditTimeline} />
      </div>
    </section>

    <section class="section section--surface" aria-labelledby="faq-title">
      <div class="container faq-layout">
        <SectionHeader kicker="Questions fréquentes" title="Avant d’analyser l’exploitation." id="faq-title" />
        <FAQ items={faqItems} />
      </div>
    </section>

    <RelatedLinks items={[
      { href: '/votre-besoin/assurer-activite-transport/', label: 'Assurer une activité de transport', text: 'Qualifier les opérations avant d’articuler les contrats.' },
      { href: '/audit-assurances-entreprise/', label: 'Audit des assurances', text: 'Comprendre la méthode commune à tous les secteurs.' },
      { href: '/flotte-automobile/', label: 'Flotte automobile', text: 'Distinguer l’usage des véhicules des responsabilités de transport.' },
      { href: '/rc-professionnelle/', label: 'RC professionnelle', text: 'Examiner les responsabilités liées aux prestations et à l’exploitation.' },
      { href: '/cyberassurance/', label: 'Cyberassurance', text: 'Examiner les outils d’exploitation, échanges de données et dépendances numériques.' },
      { href: '/assurances-entreprises/', label: 'Assurances entreprises', text: 'Relier le transport aux autres protections.' },
    ]} />
    <RelatedResources title="À lire également" items={[
      { href: '/ressources/guides/responsabilite-transporteur-assurance-marchandises-differences/', title: 'Guide complet sur la responsabilité du transporteur', description: 'Distinguer responsabilité, assurance des marchandises et couverture automobile.' },
      { href: '/ressources/methodes/audit-assurance-transport-optimisation-garanties/', title: 'Découvrir notre méthode d’audit transport', description: 'Structurer l’analyse des activités, garanties, exclusions et responsabilités.' },
      { href: '/ressources/guides/sinistralite-flotte-automobile-indicateurs-prevention/', title: 'Analyser la sinistralité d’une flotte', description: 'Lire fréquence, coût, gravité et causes avant le renouvellement.' },
      { href: '/ressources/guides/rc-professionnelle-obligatoire-qui-est-concerne/', title: 'Quand la RC professionnelle devient-elle obligatoire ?', description: 'Identifier les activités, obligations et textes qui doivent être vérifiés.' },
    ]} />
    <section class="section section--compact" aria-label="Emplacement de la future texture logistique">
      <div class="container-wide">
        <SectionIllustration
          image={transportVisuals.texture.image}
          responsive={transportVisuals.texture.responsive}
          alt="Texture graphique discrète inspirée des lignes d’un quai logistique."
          ratio="21:9"
          width={2520}
          height={1080}
          filename="texture-transport-logistique.webp"
          imageType="Texture de quai abstraite, sans marque ni texte"
          variant="panoramic-texture"
          loading="lazy"
          overlay="brand"
          position="50% 50%"
        />
      </div>
    </section>
    <PageCTA title="Mettons votre exploitation au centre de l’analyse." text="Décrivez vos activités, votre flotte et votre prochaine échéance pour cadrer le périmètre utile." primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} conversionMode />
  </main>
</SiteLayout>

<style>
  .transport-verticals { border-block: 1px solid var(--color-border); }
  .transport-verticals__layout { display: grid; grid-template-columns: minmax(17rem, .62fr) minmax(0, 1.38fr); gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .transport-verticals h2 { max-width: 15ch; margin: 0; color: var(--color-brand-ink); font-size: var(--font-size-h2); line-height: var(--line-height-heading); }
  .transport-verticals header > p:not(.eyebrow) { margin: var(--space-5) 0 0; color: var(--color-text-soft); }
  .transport-verticals ol { margin: 0; padding: 0; border-top: 1px solid var(--color-border); list-style: none; }
  .transport-verticals li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr) auto; gap: var(--space-4); align-items: start; padding: var(--space-5) 0; border-bottom: 1px solid var(--color-border); }
  .transport-verticals li > span { color: var(--color-gold-dark); font-size: var(--font-size-xs); font-weight: var(--font-weight-heading); }
  .transport-verticals h3 { margin: 0; font-size: var(--font-size-h4); }
  .transport-verticals h3 a, .transport-verticals li > a { color: var(--color-brand-deep); }
  .transport-verticals li p { margin: var(--space-2) 0 0; color: var(--color-text-soft); font-size: var(--font-size-sm); }
  .transport-verticals li > a { font-size: var(--font-size-sm); font-weight: var(--font-weight-strong); }
  .transport-verticals li i { color: var(--color-gold-dark); font-style: normal; }
  @media (max-width: 860px) { .transport-verticals__layout { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .transport-verticals li { grid-template-columns: 2rem minmax(0, 1fr); } .transport-verticals li > a { grid-column: 2; } }
</style>
