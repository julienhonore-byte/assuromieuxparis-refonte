---
type VisualRatio = '16:9' | '3:2' | '4:3' | '4:5' | '21:9';
type VisualOverlay = 'none' | 'light' | 'dark' | 'brand';
type VisualVariant = 'hero-xxl' | 'standard' | 'half-width' | 'full-width-banner' | 'panoramic-texture';
type VisualLayout = 'image-left' | 'image-right' | 'full-width' | 'content-centered' | 'text-overlay' | 'background';

interface ResponsiveSources {
  avifSrcset?: string;
  webpSrcset?: string;
  sizes?: string;
}

interface Props {
  image?: string;
  alt: string;
  ratio?: VisualRatio;
  caption?: string;
  priority?: boolean;
  loading?: 'lazy' | 'eager';
  overlay?: VisualOverlay;
  responsive?: ResponsiveSources;
  position?: string;
  width: number;
  height: number;
  filename: string;
  imageType: string;
  variant?: VisualVariant;
  layout?: VisualLayout;
  overlayEyebrow?: string;
  overlayText?: string;
}

const {
  image,
  alt,
  ratio = '16:9',
  caption,
  priority = false,
  loading = 'lazy',
  overlay = 'light',
  responsive,
  position = '50% 50%',
  width,
  height,
  filename,
  imageType,
  variant = 'standard',
  layout = 'content-centered',
  overlayEyebrow,
  overlayText,
} = Astro.props;

const effectiveLoading = priority ? 'eager' : loading;
const sizes = responsive?.sizes ?? '(max-width: 768px) 100vw, 50vw';
const hasOverlayContent = Boolean(overlayEyebrow || overlayText || Astro.slots.has('default'));
const visualRole = filename.startsWith('methode-')
  ? 'method'
  : filename.startsWith('audit-')
    ? 'audit'
    : filename.startsWith('texture-')
      ? 'texture'
      : 'hero';
---

<figure
  class:list={[
    'section-illustration',
    `section-illustration--ratio-${ratio.replace(':', '-')}`,
    `section-illustration--overlay-${overlay}`,
    `section-illustration--${variant}`,
    `section-illustration--layout-${layout}`,
    `section-illustration--role-${visualRole}`,
    { 'section-illustration--placeholder': !image },
  ]}
  style={`--visual-position: ${position};`}
  data-visual-placeholder={!image ? '' : undefined}
>
  <div class="section-illustration__media">
    {image ? (
      <picture>
        {responsive?.avifSrcset && <source type="image/avif" srcset={responsive.avifSrcset} sizes={sizes} />}
        {responsive?.webpSrcset && <source type="image/webp" srcset={responsive.webpSrcset} sizes={sizes} />}
        <img
          src={image}
          {alt}
          {width}
          {height}
          loading={effectiveLoading}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding="async"
          sizes={sizes}
        />
      </picture>
    ) : (
      <div class="section-illustration__placeholder" role="img" aria-label={`Emplacement réservé pour une future illustration. ${alt}`}>
        <span class="section-illustration__marker" aria-hidden="true">VISUEL À PRODUIRE</span>
        <strong>{filename}</strong>
        <dl>
          <div><dt>Ratio</dt><dd>{ratio}</dd></div>
          <div><dt>Master</dt><dd>{width} × {height} px</dd></div>
          <div><dt>Scène</dt><dd>{imageType}</dd></div>
        </dl>
      </div>
    )}
    {overlay !== 'none' && <span class="section-illustration__overlay" aria-hidden="true"></span>}
    {hasOverlayContent && (
      <div class="section-illustration__content">
        {overlayEyebrow && <p class="section-illustration__eyebrow">{overlayEyebrow}</p>}
        {overlayText && <p class="section-illustration__text">{overlayText}</p>}
        <slot />
      </div>
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .section-illustration {
    width: 100%;
    margin: 0;
  }

  .section-illustration--hero-xxl {
    max-width: 90rem;
  }

  .section-illustration--hero-xxl .section-illustration__media {
    min-height: clamp(22rem, 48vw, 42rem);
  }

  .section-illustration--half-width {
    width: min(100%, 42rem);
  }

  .section-illustration--full-width-banner,
  .section-illustration--panoramic-texture {
    width: 100%;
  }

  .section-illustration--full-width-banner .section-illustration__media {
    min-height: clamp(15rem, 30vw, 28rem);
  }

  .section-illustration--panoramic-texture .section-illustration__media {
    height: clamp(5rem, 7vw, 7rem);
    min-height: clamp(5rem, 7vw, 7rem);
    aspect-ratio: auto;
    border-color: rgba(185, 202, 219, 0.42);
    border-radius: 1.5rem;
    box-shadow: none;
    opacity: 0.42;
  }

  .section-illustration--role-method,
  .section-illustration--role-audit {
    width: min(45%, 38rem);
  }

  .section-illustration--role-method {
    margin-left: auto;
  }

  .section-illustration--role-audit {
    margin-right: auto;
  }

  .section-illustration--role-method .section-illustration__media,
  .section-illustration--role-audit .section-illustration__media {
    height: clamp(20rem, 28vw, 26.25rem);
    min-height: 0;
    aspect-ratio: auto;
    border-radius: 1.5rem;
    box-shadow: 0 1rem 2.5rem rgba(7, 28, 51, 0.1);
  }

  .section-illustration--role-audit .section-illustration__media {
    padding: clamp(0.35rem, 0.7vw, 0.65rem);
    background: rgba(255, 255, 255, 0.82);
    border-color: rgba(185, 202, 219, 0.62);
  }

  .section-illustration--role-audit picture,
  .section-illustration--role-audit img {
    border-radius: calc(1.5rem - 0.5rem);
  }

  .section-illustration--layout-image-left {
    margin-right: auto;
  }

  .section-illustration--layout-image-right {
    margin-left: auto;
  }

  .section-illustration--layout-content-centered {
    margin-inline: auto;
  }

  .section-illustration--layout-full-width,
  .section-illustration--layout-text-overlay,
  .section-illustration--layout-background {
    max-width: none;
  }

  .section-illustration__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--color-brand-ink);
    border: 1px solid rgba(185, 202, 219, 0.72);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-panel);
    isolation: isolate;
  }

  .section-illustration--ratio-16-9 .section-illustration__media { aspect-ratio: 16 / 9; }
  .section-illustration--ratio-3-2 .section-illustration__media { aspect-ratio: 3 / 2; }
  .section-illustration--ratio-4-3 .section-illustration__media { aspect-ratio: 4 / 3; }
  .section-illustration--ratio-4-5 .section-illustration__media { aspect-ratio: 4 / 5; }
  .section-illustration--ratio-21-9 .section-illustration__media { aspect-ratio: 21 / 9; }

  picture,
  img {
    width: 100%;
    height: 100%;
    display: block;
  }

  img {
    object-fit: cover;
    object-position: var(--visual-position);
  }

  .section-illustration__overlay {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
  }

  .section-illustration--overlay-light .section-illustration__overlay {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.3), rgba(238, 244, 250, 0.08) 58%, transparent);
  }

  .section-illustration--overlay-dark .section-illustration__overlay {
    background: linear-gradient(115deg, rgba(7, 28, 51, 0.72), rgba(7, 28, 51, 0.24) 68%, rgba(7, 28, 51, 0.08));
  }

  .section-illustration--overlay-brand .section-illustration__overlay {
    background: linear-gradient(115deg, rgba(7, 28, 51, 0.46), rgba(18, 54, 95, 0.12) 62%, rgba(201, 154, 70, 0.1));
  }

  .section-illustration__content {
    position: absolute;
    z-index: 3;
    left: clamp(1.25rem, 5vw, 5rem);
    bottom: clamp(1.25rem, 5vw, 4rem);
    width: min(40rem, calc(100% - 2.5rem));
    color: var(--color-text-on-dark);
  }

  .section-illustration--layout-content-centered .section-illustration__content {
    left: 50%;
    bottom: 50%;
    text-align: center;
    transform: translate(-50%, 50%);
  }

  .section-illustration--layout-image-right .section-illustration__content {
    right: clamp(1.25rem, 5vw, 5rem);
    left: auto;
    text-align: right;
  }

  .section-illustration__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-gold-soft);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-heading);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .section-illustration__text {
    margin: 0;
    color: inherit;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 2.25rem);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
  }

  .section-illustration__placeholder {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    align-content: end;
    gap: var(--space-4);
    padding: clamp(1.25rem, 3.6vw, 2.5rem);
    color: var(--color-text-on-dark);
    background:
      linear-gradient(rgba(185, 202, 219, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(185, 202, 219, 0.08) 1px, transparent 1px),
      radial-gradient(circle at 78% 20%, rgba(201, 154, 70, 0.2), transparent 24%),
      linear-gradient(145deg, var(--color-brand-ink), var(--color-brand-deep));
    background-size: 2.75rem 2.75rem, 2.75rem 2.75rem, auto, auto;
  }

  .section-illustration__placeholder::before,
  .section-illustration__placeholder::after {
    position: absolute;
    content: '';
    pointer-events: none;
  }

  .section-illustration__placeholder::before {
    top: 11%;
    right: 8%;
    width: 34%;
    aspect-ratio: 1;
    border: 1px solid rgba(201, 154, 70, 0.48);
    border-radius: 50%;
  }

  .section-illustration__placeholder::after {
    top: 26%;
    right: 17%;
    width: 28%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
    transform: rotate(-24deg);
    transform-origin: center;
  }

  .section-illustration__marker {
    width: fit-content;
    padding: 0.35rem 0.65rem;
    color: var(--color-gold-soft);
    border: 1px solid rgba(244, 227, 191, 0.42);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-heading);
    letter-spacing: 0.09em;
  }

  .section-illustration__placeholder strong {
    max-width: 28rem;
    color: white;
    font-size: clamp(1.05rem, 1rem + 0.45vw, 1.35rem);
    line-height: var(--line-height-heading);
    overflow-wrap: anywhere;
  }

  dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: 0;
  }

  dl div {
    display: grid;
    gap: 0.15rem;
  }

  dt {
    color: var(--color-text-on-dark-soft);
    font-size: var(--font-size-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: white;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  figcaption {
    max-width: 48rem;
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  .section-illustration--panoramic-texture .section-illustration__placeholder {
    align-content: center;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .section-illustration--panoramic-texture .section-illustration__marker,
  .section-illustration--panoramic-texture dl {
    grid-column: 1 / -1;
  }

  @media (max-width: 640px) {
    .section-illustration--role-method,
    .section-illustration--role-audit {
      width: 100%;
    }

    .section-illustration--role-method .section-illustration__media,
    .section-illustration--role-audit .section-illustration__media {
      height: clamp(15rem, 68vw, 21rem);
    }

    .section-illustration--panoramic-texture .section-illustration__media {
      height: 4rem;
      min-height: 4rem;
    }

    .section-illustration__placeholder {
      padding: var(--space-5);
    }

    .section-illustration__placeholder::before {
      width: 44%;
    }

    .section-illustration--hero-xxl .section-illustration__media,
    .section-illustration--full-width-banner .section-illustration__media {
      min-height: 0;
    }

    .section-illustration__content,
    .section-illustration--layout-image-right .section-illustration__content {
      right: var(--space-5);
      bottom: var(--space-5);
      left: var(--space-5);
      width: auto;
      text-align: left;
    }

    .section-illustration--layout-content-centered .section-illustration__content {
      right: var(--space-5);
      bottom: 50%;
      left: var(--space-5);
      width: auto;
      transform: translateY(50%);
    }

    .section-illustration--panoramic-texture .section-illustration__placeholder {
      display: grid;
      grid-template-columns: 1fr;
    }

    dl {
      gap: var(--space-2) var(--space-4);
    }

    dl div:last-child {
      flex-basis: 100%;
    }
  }
</style>
