---
import ConversionActions from '../components/ConversionActions.astro';
import CoverageMap from '../components/CoverageMap.astro';
import FAQ from '../components/FAQ.astro';
import PageCTA from '../components/PageCTA.astro';
import PageHero from '../components/PageHero.astro';
import ProcessDiagram from '../components/ProcessDiagram.astro';
import ProductAudience from '../components/ProductAudience.astro';
import ProductHeroDiagram from '../components/ProductHeroDiagram.astro';
import ProductReview from '../components/ProductReview.astro';
import ProductRiskOverview from '../components/ProductRiskOverview.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import RiskMap from '../components/RiskMap.astro';
import SectionIllustration from '../components/SectionIllustration.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SolutionMethod from '../components/SolutionMethod.astro';
import TimelineDiagram from '../components/TimelineDiagram.astro';
import TrustBar from '../components/TrustBar.astro';
import WhatWeAnalyze from '../components/WhatWeAnalyze.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { baseSchemas, breadcrumbSchema, pageUrl, serviceSchema } from '../data/seo';
import { prepareVisual } from '../data/visualLibrary';

const path = '/sante-prevoyance-entreprise/';
const pageVisuals = { hero: prepareVisual('sante-prevoyance', 'hero-sante-prevoyance-equipe', 'hero'), audit: prepareVisual('sante-prevoyance', 'audit-sante-prevoyance-entreprise', 'audit'), method: prepareVisual('sante-prevoyance', 'methode-sante-prevoyance-regimes', 'method'), texture: prepareVisual('sante-prevoyance', 'texture-sante-prevoyance-collectif', 'texture') };
const title = 'Santé et prévoyance entreprise | Assuromieux Paris';
const description = 'Santé et prévoyance entreprise : analyse des catégories, garanties, conventions collectives, dispenses, portabilité et obligations applicables.';
const contactHref = '/?besoin=sante-prevoyance&intent=quote&product=sante-prevoyance#contact';
const ctaLabel = 'Recevoir mon devis Santé Entreprise';
const auditHref = '/?besoin=audit-assurances-entreprise&intent=audit&product=sante-prevoyance#contact';
const auditLabel = 'Faire analyser mon régime santé et prévoyance';
const socialProtectionAnalysisProcess = [
  { label: 'Comprendre l’entreprise et les populations', icon: 'activity' as const },
  { label: 'Identifier la convention collective et les obligations applicables', icon: 'document' as const },
  { label: 'Analyser le régime actuel', icon: 'search' as const },
  { label: 'Examiner garanties, cotisations et catégories de bénéficiaires', icon: 'search' as const },
  { label: 'Identifier les écarts et points de vigilance', icon: 'search' as const },
  { label: 'Consulter le marché si nécessaire', icon: 'market' as const },
  { label: 'Formuler des recommandations', icon: 'recommendation' as const },
];
const socialProtectionIssues = [
  { label: 'Complémentaire santé', icon: 'shield' as const },
  { label: 'Prévoyance incapacité', icon: 'continuity' as const },
  { label: 'Invalidité', icon: 'continuity' as const },
  { label: 'Décès', icon: 'continuity' as const },
  { label: 'Catégories de salariés', icon: 'people' as const },
  { label: 'Convention collective', icon: 'network' as const },
  { label: 'Participation employeur', icon: 'people' as const },
  { label: 'Dispenses', icon: 'shield' as const },
  { label: 'Portabilité', icon: 'continuity' as const },
  { label: 'Protection du dirigeant', icon: 'people' as const },
];
const collectiveSchemeStages = [
  { label: 'Entreprise' },
  { label: 'Population concernée' },
  { label: 'Obligations et objectifs' },
  { label: 'Garanties à vérifier', items: ['Santé', 'Incapacité', 'Invalidité', 'Décès', 'Assistance', 'Options facultatives', 'Protection du dirigeant selon statut'] },
  { label: 'Régime collectif' },
];
const socialProtectionReviewTimeline = [
  { label: 'Prise de contact', icon: 'activity' as const },
  { label: 'Identification des effectifs et catégories', icon: 'people' as const },
  { label: 'Collecte des contrats et documents', icon: 'document' as const },
  { label: 'Analyse du régime existant', icon: 'search' as const },
  { label: 'Vérification des garanties et points de vigilance', icon: 'search' as const },
  { label: 'Consultation éventuelle du marché', icon: 'market' as const, optional: true },
  { label: 'Restitution et accompagnement', icon: 'support' as const },
];
const faqItems = [
  { question: 'Santé collective et prévoyance couvrent-elles les mêmes événements ?', answer: 'Non. La complémentaire santé intervient sur des frais de soins selon ses niveaux de remboursement. La prévoyance traite notamment, selon le contrat, l’incapacité, l’invalidité ou le décès. Leur articulation doit être vérifiée.' },
  { question: 'Les mêmes garanties doivent-elles s’appliquer à tous les salariés ?', answer: 'Le caractère collectif et, le cas échéant, les catégories objectives de salariés doivent être vérifiés selon la situation de l’entreprise, l’acte de mise en place, la convention collective et les textes en vigueur. Une validation métier ou juridique peut être nécessaire.' },
  { question: 'Que faut-il vérifier lors d’un changement de contrat ?', answer: 'Les niveaux de couverture, la participation employeur, les catégories, dispenses, services, délais de gestion, situations en cours, modalités de maintien et information des salariés doivent être préparés avec prudence.' },
  { question: 'La protection du dirigeant est-elle incluse ?', answer: 'Pas nécessairement. Son statut social, son affiliation et ses besoins personnels doivent être examinés. La protection du dirigeant peut nécessiter une analyse distincte de celle des salariés.' },
];
const structuredData = [
  ...baseSchemas,
  breadcrumbSchema([{ name: 'Accueil', path: '/' }, { name: 'Assurances entreprises', path: '/assurances-entreprises/' }, { name: 'Santé et prévoyance entreprise', path }]),
  serviceSchema('Conseil en santé et prévoyance collective', description, path),
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
];
---

<SiteLayout {title} {description} canonical={pageUrl(path)} currentPath={path} ctaHref={contactHref} {ctaLabel} {structuredData}>
  <main id="contenu-principal">
    <PageHero
      eyebrow="Santé et prévoyance collective"
      title="Construire une protection sociale lisible pour l’entreprise et ses équipes."
      lead="Nous rapprochons la situation de l’entreprise, les catégories de personnel, les textes applicables et les garanties pour vous aider à faire évoluer le régime avec méthode."
      breadcrumbs={[{ href: '/', label: 'Accueil' }, { href: '/assurances-entreprises/', label: 'Assurances entreprises' }, { label: 'Santé et prévoyance' }]}
    >
      <ConversionActions primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} density="hero" analyticsLocation="hero" analyticsSource="sante_hero" />
      <ProductHeroDiagram slot="visual" label="Protection collective" items={['Santé', 'Incapacité', 'Invalidité', 'Décès']} variant="collective" />
    </PageHero>
    <TrustBar />
    <section class="section section--compact" aria-label="Illustration de l’expertise Santé et Prévoyance"><div class="container-wide"><SectionIllustration image={pageVisuals.hero.image} responsive={pageVisuals.hero.responsive} alt="Équipe d’entreprise dans un environnement de travail lumineux et inclusif." ratio="16:9" width={3200} height={1800} filename="hero-sante-prevoyance-equipe.webp" imageType="Équipe et protection collective" priority overlay="brand" /></div></section>

    <ProductAudience
      title="Aux employeurs qui veulent clarifier leurs régimes collectifs et leur évolution."
      paragraphs={[
        'La complémentaire santé collective et la prévoyance concernent les salariés, mais leur organisation dépend de la situation de l’entreprise, de la convention collective, des accords applicables et des catégories de personnel. Les obligations ne doivent pas être déduites d’une présentation générale.',
        'L’analyse devient utile lors d’une embauche, d’un changement de convention collective, d’une restructuration des catégories, d’une hausse de cotisation ou d’une évolution des garanties. Elle doit aussi anticiper l’information des salariés et les situations individuelles en cours.',
      ]}
      markers={['Employeurs', 'Salariés', 'Catégories de personnel', 'Dirigeants selon leur statut']}
      variant="split"
    />

    <ProductRiskOverview
      title="Mutuelle d’entreprise et prévoyance : deux protections différentes"
      intro="La mutuelle collective complète certains remboursements de soins. La prévoyance collective traite principalement les conséquences financières de certains événements affectant les personnes, selon les garanties prévues."
      items={[
        { title: 'La mutuelle d’entreprise', text: 'La mutuelle collective complète les remboursements des frais de santé selon les garanties prévues : consultations, hospitalisation, optique, dentaire et autres postes couverts. Le contrat doit être analysé selon la population salariée, les catégories concernées, le financement, les dispenses et le cadre collectif applicable.' },
        { title: 'La prévoyance collective', text: 'Elle concerne principalement les conséquences financières d’un arrêt de travail, d’une invalidité ou d’un décès. Elle ne remplit pas le même rôle que la mutuelle et ses garanties doivent être appréciées avec les obligations conventionnelles et les dispositifs existants.' },
        { title: 'La protection personnelle du dirigeant', text: 'Le dirigeant doit également vérifier sa propre situation, qui peut différer de celle des salariés selon son statut, son régime social, son affiliation et les garanties déjà en place.' },
      ]}
      distinction="Mutuelle d’entreprise, prévoyance collective et protection personnelle du dirigeant doivent être examinées séparément avant d’être coordonnées."
      variant="ledger"
    />
    <section class="section" aria-label="Cartographie pédagogique des enjeux de santé et de prévoyance">
      <div class="container-wide">
        <RiskMap title="Les enjeux d’un régime collectif dépendent de la situation de l’entreprise." description="Cette cartographie présente les principaux sujets à examiner sans présumer qu’ils sont tous obligatoires ou applicables dans chaque situation." center="Protection sociale de l’entreprise" risks={socialProtectionIssues} />
      </div>
    </section>

    <ProductReview
      checksTitle="Vérifier le cadre avant de comparer les niveaux."
      checksIntro="Toute conclusion réglementaire dépend du contexte. Les documents de l’entreprise et les textes applicables doivent être rapprochés."
      checks={[
        'La convention collective, les accords et l’acte de mise en place du régime sont identifiés dans leur version pertinente.',
        'Le caractère collectif, les catégories objectives éventuelles et les conditions d’affiliation sont vérifiés avec précision.',
        'La participation de l’employeur et les modalités de financement sont vérifiées selon le régime et les règles applicables.',
        'Les dispenses sont documentées et administrées selon les règles applicables.',
        'Les garanties santé sont comparées par poste et les garanties prévoyance par événement et définition.',
        'Portabilité, maintien de garanties et situations en cours sont préparés avant un changement.',
        'La protection du dirigeant est examinée séparément selon son statut social et son affiliation.',
      ]}
      mistakesTitle="Les décisions qui demandent le plus de précaution."
      mistakesIntro="Le risque principal est de comparer des tableaux de garanties sans vérifier le cadre collectif qui leur donne effet."
      mistakes={[
        { title: 'Appliquer une règle générale', text: 'Les obligations doivent être vérifiées selon l’entreprise, la convention collective, les accords applicables et la catégorie de personnel.' },
        { title: 'Mélanger santé et prévoyance', text: 'Un bon remboursement de soins ne renseigne pas sur la protection en cas d’incapacité, d’invalidité ou de décès.' },
        { title: 'Changer sans préparer la transition', text: 'Les affiliations, dispenses, salariés en arrêt, maintiens et informations collectives peuvent nécessiter un traitement spécifique.' },
        { title: 'Inclure le dirigeant par défaut', text: 'Le statut social et les dispositifs existants du dirigeant doivent être analysés avant de conclure sur sa couverture.' },
      ]}
      note={{ title: 'Santé et prévoyance ne couvrent pas les mêmes événements', text: 'Les deux volets se complètent mais ne se substituent pas. Les garanties, obligations et niveaux doivent être lus selon le cadre réellement applicable à l’entreprise.' }}
      variant="reverse"
    />
    <section class="section section--surface" aria-label="Architecture pédagogique du régime collectif">
      <div class="container-wide">
        <CoverageMap title="Relier le régime collectif aux populations et aux textes applicables." description="Le régime dépend notamment de la population concernée, du cadre applicable et des garanties effectivement prévues au contrat." stages={collectiveSchemeStages} />
      </div>
    </section>

    <WhatWeAnalyze />
    <section class="section section--compact section--surface" aria-label="Illustration de la méthode Santé et Prévoyance"><div class="container-wide"><SectionIllustration image={pageVisuals.method.image} responsive={pageVisuals.method.responsive} alt="Analyse de régimes collectifs, catégories et garanties sur documents." ratio="3:2" width={2400} height={1600} filename="methode-sante-prevoyance-regimes.webp" imageType="Régimes collectifs et garanties" loading="lazy" overlay="light" /></div></section>
    <section class="section" aria-label="Méthode d’analyse Santé et Prévoyance en sept étapes">
      <div class="container-wide">
        <ProcessDiagram title="Notre méthode d’analyse Santé et Prévoyance." description="Sept étapes structurent l’étude des populations, du cadre communiqué et des garanties, sans déterminer automatiquement une obligation juridique ni garantir une conformité réglementaire." steps={socialProtectionAnalysisProcess} />
      </div>
    </section>
    <SolutionMethod title="Clarifier le cadre, puis les garanties." text="Assuromieux rassemble les dispositifs existants, les catégories et les textes communiqués par l’entreprise. Les écarts sont analysés avant toute consultation, avec signalement des points qui exigent une validation métier ou juridique.">
      <ConversionActions slot="actions" primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} tone="dark" density="compact" analyticsLocation="method" analyticsSource="sante_method" />
    </SolutionMethod>
    <section class="section" aria-label="Déroulement chronologique d’une revue Santé et Prévoyance">
      <div class="container-wide">
        <TimelineDiagram title="Le déroulement d’une revue Santé et Prévoyance." description="La revue organise les éléments disponibles et, si elle est pertinente, une consultation du marché, sans promettre une économie, une conformité automatique ou une amélioration garantie." events={socialProtectionReviewTimeline} />
      </div>
    </section>
    <section class="section section--surface" aria-labelledby="faq-title"><div class="container faq-layout"><SectionHeader kicker="Questions fréquentes" title="Avant de faire évoluer un régime collectif." id="faq-title" /><FAQ items={faqItems} /></div></section>
    <RelatedLinks items={[
      { href: '/protection-dirigeant/', label: 'Protection du dirigeant', text: 'Étudier les besoins personnels et la continuité.' },
      { href: '/audit-assurances-entreprise/', label: 'Audit des assurances', text: 'Relier les régimes collectifs au programme global.' },
      { href: '/ressources/guides/mutuelle-entreprise-prevoyance-collective-differences/', label: 'Mutuelle ou prévoyance collective ?', text: 'Distinguer les frais de santé de l’incapacité, de l’invalidité et du décès.' },
      { href: '/assurances-entreprises/', label: 'Assurances entreprises', text: 'Revenir à la vision d’ensemble des protections.' },
      { href: '/ressources/dirigeants/', label: 'Ressources pour dirigeants', text: 'Approfondir les protections de l’entreprise et de ses responsables.' },
      { href: '/multirisque-professionnelle/', label: 'Continuité et multirisque', text: 'Coordonner les régimes collectifs avec les biens, les charges et la continuité de l’activité.' },
      { href: '/cyberassurance/', label: 'Données sociales et risque cyber', text: 'Intégrer les données du personnel et les dépendances numériques à la lecture du programme.' },
      { href: '/rc-professionnelle/', label: 'Responsabilités de l’entreprise', text: 'Distinguer la protection des personnes des responsabilités liées aux prestations et à l’exploitation.' },
    ]} />
    <section class="section section--compact" aria-label="Illustration d’un audit Santé et Prévoyance"><div class="container-wide"><SectionIllustration image={pageVisuals.audit.image} responsive={pageVisuals.audit.responsive} alt="Réunion consacrée à la protection sociale collective d’une entreprise." ratio="4:3" width={2400} height={1800} filename="audit-sante-prevoyance-entreprise.webp" imageType="Protection sociale collective" loading="lazy" overlay="light" /></div></section>
    <section class="section section--compact" aria-label="Texture visuelle Santé et Prévoyance"><div class="container-wide"><SectionIllustration image={pageVisuals.texture.image} responsive={pageVisuals.texture.responsive} alt="Texture panoramique douce évoquant la protection collective." ratio="21:9" width={2520} height={1080} filename="texture-sante-prevoyance-collectif.webp" imageType="Texture de protection collective" variant="panoramic-texture" loading="lazy" overlay="brand" /></div></section>
    <PageCTA title="Votre régime collectif correspond-il encore à l’entreprise ?" text="Présentez les catégories, la convention collective et les dispositifs existants pour identifier les vérifications prioritaires." primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} conversionMode />
  </main>
</SiteLayout>
