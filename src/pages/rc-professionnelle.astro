---
import ConversionActions from '../components/ConversionActions.astro';
import CoverageMap from '../components/CoverageMap.astro';
import FAQ from '../components/FAQ.astro';
import PageCTA from '../components/PageCTA.astro';
import PageHero from '../components/PageHero.astro';
import ProcessDiagram from '../components/ProcessDiagram.astro';
import ProductAudience from '../components/ProductAudience.astro';
import ProductHeroDiagram from '../components/ProductHeroDiagram.astro';
import ProductReview from '../components/ProductReview.astro';
import ProductRiskOverview from '../components/ProductRiskOverview.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import RelatedResources from '../components/RelatedResources.astro';
import RiskMap from '../components/RiskMap.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SolutionMethod from '../components/SolutionMethod.astro';
import TimelineDiagram from '../components/TimelineDiagram.astro';
import TrustBar from '../components/TrustBar.astro';
import WhatWeAnalyze from '../components/WhatWeAnalyze.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { baseSchemas, breadcrumbSchema, pageUrl, serviceSchema } from '../data/seo';

const path = '/rc-professionnelle/';
const title = 'Assurance RC professionnelle entreprise | Assuromieux Paris';
const description = 'RC professionnelle : analyse des activités déclarées, responsabilités, dommages, plafonds, franchises, exclusions et sous-traitance.';
const contactHref = '/?besoin=rc-professionnelle&intent=quote&product=rc-professionnelle#contact';
const ctaLabel = 'Démarrer ma demande de devis RC Pro';
const auditHref = '/?besoin=audit-assurances-entreprise&intent=audit&product=rc-professionnelle#contact';
const auditLabel = 'Faire analyser ma RC professionnelle';
const rcAnalysisProcess = [
  { label: 'Comprendre l’activité', icon: 'activity' as const },
  { label: 'Identifier les prestations réellement réalisées', icon: 'search' as const },
  { label: 'Analyser le contrat existant', icon: 'document' as const },
  { label: 'Vérifier les responsabilités et dommages exposés', icon: 'search' as const },
  { label: 'Examiner plafonds, franchises et exclusions', icon: 'document' as const },
  { label: 'Consulter le marché', note: 'Si nécessaire', icon: 'market' as const },
  { label: 'Formuler des recommandations', icon: 'recommendation' as const },
];
const responsibilityRisks = [
  { label: 'Erreur professionnelle', icon: 'shield' as const },
  { label: 'Omission', icon: 'continuity' as const },
  { label: 'Conseil', icon: 'people' as const },
  { label: 'Dommage matériel', icon: 'goods' as const },
  { label: 'Dommage immatériel', icon: 'continuity' as const },
  { label: 'RC exploitation', icon: 'shield' as const },
  { label: 'Sous-traitance', icon: 'network' as const },
  { label: 'Biens confiés', icon: 'goods' as const },
  { label: 'Données / Cyber', icon: 'cyber' as const },
  { label: 'Engagements contractuels', icon: 'shield' as const },
];
const responsibilityCoverageStages = [
  { label: 'Activité exercée' },
  { label: 'Situation ou fait générateur' },
  { label: 'Type de dommage' },
  { label: 'Responsabilité possible' },
  { label: 'Garantie à vérifier', items: ['RC professionnelle', 'RC exploitation', 'Après livraison / après travaux', 'Biens confiés', 'Protection juridique', 'Cyber'] },
];
const rcReviewTimeline = [
  { label: 'Prise de contact', icon: 'activity' as const },
  { label: 'Description des activités', icon: 'people' as const },
  { label: 'Collecte des contrats', icon: 'document' as const },
  { label: 'Analyse des garanties', icon: 'search' as const },
  { label: 'Identification des écarts', icon: 'search' as const },
  { label: 'Consultation éventuelle du marché', icon: 'market' as const, optional: true },
  { label: 'Restitution et accompagnement', icon: 'support' as const },
];

const audience = {
  title: 'Aux entreprises dont l’activité peut engager une responsabilité envers un client ou un tiers.',
  paragraphs: [
    'La responsabilité civile professionnelle concerne les conséquences que peuvent avoir une prestation, un conseil, une erreur, une faute, une omission ou une négligence. La nature exacte de l’exposition dépend du métier, des engagements contractuels et des dommages susceptibles d’être invoqués.',
    'L’analyse est utile lors de la création d’une activité, de l’ajout d’une prestation, du recours à des sous-traitants ou de la signature d’un contrat client exigeant des garanties précises. Elle consiste d’abord à vérifier que l’activité décrite au contrat correspond à celle réellement exercée.',
  ],
  markers: ['Entreprises de services', 'Professions libérales', 'Conseil et ingénierie', 'Artisans et PME'],
};

const risks = [
  { title: 'Prestations et conseils', text: 'Une erreur, une omission, un retard ou une prestation contestée peut conduire un client à demander réparation. La réponse dépend de l’activité déclarée, du fait générateur, des exclusions et des garanties souscrites.' },
  { title: 'Dommages causés à des tiers', text: 'Les réclamations peuvent porter sur des dommages corporels, matériels ou immatériels, consécutifs ou non consécutifs selon les définitions du contrat. Leur prise en charge, leurs plafonds et leurs exclusions varient.' },
  { title: 'Vie courante de l’exploitation', text: 'Un dommage peut survenir en dehors de la prestation elle-même : accueil d’un visiteur, intervention dans des locaux, événement ou manipulation d’un bien. Cette exposition relève souvent d’une lecture distincte de la RC exploitation.' },
  { title: 'Responsabilités propres au métier', text: 'Certaines activités appellent des extensions, des obligations ou des contrats spécifiques. Défense, recours, responsabilité après livraison ou atteinte aux données doivent être vérifiés selon le contrat.' },
];

const checks = [
  'Les activités, prestations et zones d’intervention sont décrites sans approximation dans les conditions particulières.',
  'Les dommages corporels, matériels et immatériels sont définis et articulés avec des plafonds adaptés au risque étudié.',
  'Les franchises, sous-limites et exclusions sont lues pour chaque type de réclamation important.',
  'La territorialité de la garantie et les juridictions admises sont rapprochées des pays dans lesquels l’entreprise travaille, livre ou peut être mise en cause.',
  'Le recours à la sous-traitance et la responsabilité qui en découle sont déclarés et compris.',
  'La période de garantie, les modalités de réclamation et les contrats antérieurs sont rapprochés.',
  'Les frais ou garanties de défense et le recours sont identifiés sans présumer qu’ils interviennent dans toutes les situations.',
];

const mistakes = [
  { title: 'Décrire l’activité trop largement', text: 'Un libellé générique ne prouve pas que chaque prestation est couverte. Les activités réelles et leurs évolutions doivent être présentées précisément.' },
  { title: 'Confondre RC Pro et RC exploitation', text: 'La première vise principalement les conséquences de l’activité professionnelle ; la seconde concerne davantage la vie courante de l’entreprise. Leur articulation varie selon le contrat.' },
  { title: 'Comparer uniquement le plafond global', text: 'Des sous-limites, franchises ou exclusions peuvent modifier fortement la réponse sur un dommage immatériel, une atteinte particulière ou une réclamation à l’étranger.' },
  { title: 'Oublier contrats et sous-traitants', text: 'Les engagements acceptés auprès des clients et l’organisation de la sous-traitance peuvent créer des écarts entre le risque réel et le dossier présenté au marché.' },
];

const faqItems = [
  { question: 'La RC professionnelle est-elle obligatoire pour toutes les entreprises ?', answer: 'Non, pas dans tous les métiers. Certaines professions ou activités sont soumises à des obligations spécifiques. La situation doit être vérifiée selon l’activité, la réglementation applicable et les engagements pris par l’entreprise.' },
  { question: 'Quelle différence entre dommage matériel et dommage immatériel ?', answer: 'Le dommage matériel atteint un bien ; le dommage immatériel correspond notamment à une conséquence financière. Les contrats distinguent souvent le dommage immatériel consécutif d’un dommage immatériel non consécutif, avec des conditions et plafonds différents.' },
  { question: 'La RC Pro couvre-t-elle automatiquement les sous-traitants ?', answer: 'Pas nécessairement. Le recours à la sous-traitance, la responsabilité conservée par l’entreprise et les assurances des intervenants doivent être examinés. La réponse dépend des personnes assurées, des garanties souscrites et des exclusions.' },
  { question: 'Que faut-il préparer pour analyser la RC professionnelle ?', answer: 'Une description précise des prestations, les contrats clients significatifs, les zones d’intervention, la part sous-traitée, les attestations et les informations de sinistralité disponibles constituent une base utile.' },
];

const structuredData = [
  ...baseSchemas,
  breadcrumbSchema([{ name: 'Accueil', path: '/' }, { name: 'Assurances entreprises', path: '/assurances-entreprises/' }, { name: 'RC professionnelle', path }]),
  serviceSchema('Conseil en assurance responsabilité civile professionnelle', description, path),
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
];
---

<SiteLayout {title} {description} canonical={pageUrl(path)} currentPath={path} ctaHref={contactHref} {ctaLabel} {structuredData}>
  <main id="contenu-principal">
    <PageHero
      eyebrow="Responsabilité civile professionnelle"
      title="Comprendre ce que votre responsabilité professionnelle doit réellement couvrir."
      lead="Nous rapprochons vos prestations, vos engagements et les réclamations possibles pour vous aider à vérifier si le contrat répond aux responsabilités réellement exposées."
      breadcrumbs={[{ href: '/', label: 'Accueil' }, { href: '/assurances-entreprises/', label: 'Assurances entreprises' }, { label: 'RC professionnelle' }]}
    >
      <ConversionActions primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} density="hero" analyticsLocation="hero" analyticsSource="rc_pro_hero" />
      <ProductHeroDiagram slot="visual" label="RC professionnelle" items={['Prestations', 'Tiers', 'Exploitation', 'Réclamations']} variant="orbit" />
    </PageHero>
    <TrustBar />

    <ProductAudience {...audience} variant="split" />
    <ProductRiskOverview
      title="Plusieurs responsabilités peuvent se croiser."
      intro="Le nom du contrat ne suffit pas à décrire sa portée. Les définitions, faits générateurs et exclusions doivent être rapprochés des situations concrètes de l’entreprise."
      items={risks}
      distinction="RC Pro et RC exploitation : deux notions à distinguer. Elles peuvent figurer dans un même contrat, mais ne répondent pas nécessairement aux mêmes faits, dommages ou plafonds."
      variant="ledger"
    />
    <section class="section" aria-label="Cartographie pédagogique des risques de responsabilité">
      <div class="container-wide">
        <RiskMap title="Plusieurs risques de responsabilité entourent l’activité." description="Cette cartographie présente des situations à examiner selon le métier et le contrat, sans présumer qu’elles sont toutes couvertes par une responsabilité civile professionnelle." center="Entreprise / professionnel" risks={responsibilityRisks} />
      </div>
    </section>
    <ProductReview
      checksTitle="Lire les limites avant d’évaluer la protection."
      checksIntro="Une analyse du risque est nécessaire pour hiérarchiser les clauses réellement déterminantes."
      {checks}
      mistakesTitle="Les raccourcis qui fragilisent l’analyse."
      mistakesIntro="La prudence consiste à partir des prestations et des engagements, puis à revenir aux conditions particulières et générales."
      {mistakes}
      note={{ title: 'RC Pro et RC exploitation : deux notions à distinguer', text: 'Selon le contrat, leurs garanties peuvent être regroupées ou séparées. Il faut vérifier les dommages visés, les plafonds, les exclusions et le moment où la responsabilité est engagée.' }}
      variant="split"
    />
    <section class="section section--surface" aria-label="Architecture pédagogique des responsabilités">
      <div class="container-wide">
        <CoverageMap title="Relier les faits, les dommages et les garanties." description="L’intitulé « RC Pro » ne suffit pas à définir la portée du contrat : l’activité, le fait générateur, le dommage et la responsabilité possible doivent conduire à la garantie réellement prévue." stages={responsibilityCoverageStages} />
      </div>
    </section>

    <WhatWeAnalyze />
    <section class="section" aria-label="Méthode d’analyse RC professionnelle en sept étapes">
      <div class="container-wide">
        <ProcessDiagram title="Notre méthode d’analyse RC professionnelle." description="Sept étapes structurent la lecture des activités, responsabilités et contrats. Cette analyse ne constitue pas une qualification juridique définitive." steps={rcAnalysisProcess} />
      </div>
    </section>
    <SolutionMethod title="Une analyse centrée sur vos responsabilités réelles." text="Assuromieux décrit les prestations, étudie le contrat et les réclamations possibles, puis consulte le marché lorsque les écarts justifient une comparaison. La recommandation présente les limites identifiées et les arbitrages envisageables.">
      <ConversionActions slot="actions" primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} tone="dark" density="compact" analyticsLocation="method" analyticsSource="rc_pro_method" />
    </SolutionMethod>
    <section class="section" aria-label="Déroulement chronologique d’une revue RC professionnelle">
      <div class="container-wide">
        <TimelineDiagram title="Le déroulement d’une revue RC professionnelle." description="La revue organise les informations disponibles et, si nécessaire, une consultation du marché, sans promettre une acceptation, une économie ou une garantie automatique." events={rcReviewTimeline} />
      </div>
    </section>

    <section class="section section--surface" aria-labelledby="faq-title">
      <div class="container faq-layout"><SectionHeader kicker="Questions fréquentes" title="Avant de revoir votre RC professionnelle." id="faq-title" /><FAQ items={faqItems} /></div>
    </section>

    <RelatedLinks items={[
      { href: '/audit-assurances-entreprise/', label: 'Audit des assurances', text: 'Relier la RC professionnelle au programme global.' },
      { href: '/ressources/guides/rc-professionnelle-obligatoire-qui-est-concerne/', label: 'RC professionnelle obligatoire', text: 'Identifier les activités et les textes à vérifier.' },
      { href: '/assurance-transport/', label: 'Transport et logistique', text: 'Distinguer les responsabilités de prestation et de transport.' },
      { href: '/assurance-btp-decennale/', label: 'BTP et décennale', text: 'Relier activités déclarées, responsabilités et attestations.' },
      { href: '/multirisque-professionnelle/', label: 'Multirisque professionnelle', text: 'Examiner les locaux, les biens et la continuité.' },
      { href: '/cyberassurance/', label: 'Cyberassurance', text: 'Distinguer responsabilité numérique, crise et restauration.' },
    ]} />
    <RelatedResources title="À lire également pour les activités de transport" items={[
      { href: '/ressources/guides/responsabilite-transporteur-assurance-marchandises-differences/', title: 'Responsabilités du transporteur et marchandises', description: 'Distinguer la responsabilité de transport des autres garanties professionnelles.' },
      { href: '/ressources/methodes/audit-assurance-transport-optimisation-garanties/', title: 'Voir comment s’organise un audit assurance transport', description: 'Rapprocher les activités, contrats, responsabilités et exclusions.' },
      { href: '/ressources/guides/sinistralite-flotte-automobile-indicateurs-prevention/', title: 'Rapprocher sinistralité, flotte et prévention', description: 'Analyser les événements avec les usages, conducteurs et franchises.' },
    ]} />
    <PageCTA title="Votre activité est-elle décrite avec suffisamment de précision ?" text="Présentez vos prestations, vos clients et votre prochaine échéance pour cadrer les clauses à examiner en priorité." primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} conversionMode />
  </main>
</SiteLayout>
