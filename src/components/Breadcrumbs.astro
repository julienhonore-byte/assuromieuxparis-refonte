---
interface Item {
  href?: string;
  label: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Fil d’Ariane">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href && index < items.length - 1
          ? <a href={item.href}>{item.label}</a>
          : <span aria-current={index === items.length - 1 ? 'page' : undefined}>{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  ol {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin: 0;
    padding: var(--space-4) 0;
    list-style: none;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  li:not(:last-child)::after {
    content: '/';
    margin-left: var(--space-2);
    color: var(--color-gold-dark);
  }

  a:hover {
    color: var(--color-brand);
  }

  @media (max-width: 640px) {
    ol {
      flex-wrap: nowrap;
      gap: var(--space-2);
      padding-block: var(--space-3);
      overflow: hidden;
      font-size: var(--font-size-xs);
    }

    li {
      min-width: 0;
    }

    li:not(:nth-last-child(-n + 2)) {
      display: none;
    }

    li:nth-last-child(2) {
      max-width: 42%;
      display: flex;
      align-items: center;
      flex: 0 1 auto;
      white-space: nowrap;
    }

    li:last-child {
      flex: 1 1 auto;
      overflow: hidden;
    }

    li:last-child span,
    li:nth-last-child(2) a {
      max-width: 100%;
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    li:not(:last-child)::after {
      flex: 0 0 auto;
    }

    a {
      min-height: 2.25rem;
    }
  }
</style>
