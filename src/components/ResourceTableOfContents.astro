---
interface Heading { depth: number; slug: string; text: string; }
interface Props { headings: Heading[]; }
const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2);
---
{items.length > 0 && <details class="resource-toc" data-resource-toc open>
  <summary>Dans ce guide <span aria-hidden="true">⌄</span></summary>
  <nav aria-label="Sommaire du guide">
    <ol>{items.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
  </nav>
</details>}

<script>
  const tocMedia = window.matchMedia('(max-width: 640px)');
  const resourceTocs = document.querySelectorAll<HTMLDetailsElement>('[data-resource-toc]');

  const syncResourceTocs = () => {
    resourceTocs.forEach((toc) => {
      toc.open = !tocMedia.matches;
    });
  };

  tocMedia.addEventListener('change', syncResourceTocs);
  syncResourceTocs();
</script>

<style>
  .resource-toc { position: sticky; top: var(--space-6); padding: var(--space-6); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-card-sm); }
  summary { display: none; color: var(--color-brand-deep); font-size: var(--font-size-sm); font-weight: var(--font-weight-heading); cursor: pointer; }
  ol { display: grid; gap: var(--space-2); margin: 0; padding: 0; list-style: none; counter-reset: toc; }
  li { counter-increment: toc; }
  a { min-height: 2.75rem; display: flex; align-items: center; gap: var(--space-3); color: var(--color-text-soft); font-size: var(--font-size-sm); text-decoration: none; }
  a::before { content: counter(toc, decimal-leading-zero); color: var(--color-gold-dark); font-size: var(--font-size-xs); font-weight: var(--font-weight-heading); }
  a:hover { color: var(--color-brand); text-decoration: underline; }
  @media (max-width: 980px) { .resource-toc { position: static; } }
  @media (max-width: 640px) {
    .resource-toc {
      padding: 0;
      overflow: clip;
    }

    summary {
      min-height: 3.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding-inline: var(--space-5);
      list-style: none;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary span {
      color: var(--color-gold-dark);
      font-size: 1.25rem;
      transition: transform var(--transition-fast);
    }

    .resource-toc[open] summary span {
      transform: rotate(180deg);
    }

    nav {
      padding: 0 var(--space-5) var(--space-5);
      border-top: 1px solid var(--color-border);
    }

    ol {
      padding-top: var(--space-3);
    }
  }
</style>
