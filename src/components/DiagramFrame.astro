---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  tone?: 'light' | 'surface' | 'dark';
}

const { eyebrow, title, intro, tone = 'light' } = Astro.props;
---

<section class:list={['diagram-frame', `diagram-frame--${tone}`]}>
  <header class="diagram-frame__header">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    {intro && <p>{intro}</p>}
  </header>
  <div class="diagram-frame__canvas">
    <slot />
  </div>
</section>

<style>
  .diagram-frame {
    --diagram-ink: var(--color-brand-ink);
    --diagram-deep: var(--color-brand-deep);
    --diagram-gold: var(--color-gold-dark);
    --diagram-line: rgba(18, 54, 95, 0.22);
    --diagram-surface: rgba(255, 255, 255, 0.94);
    width: 100%;
    overflow: hidden;
    color: var(--diagram-ink);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(238, 244, 250, 0.88));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-panel);
  }

  .diagram-frame--surface { background: linear-gradient(145deg, var(--color-surface), rgba(255, 255, 255, 0.96)); }
  .diagram-frame--dark {
    --diagram-ink: white;
    --diagram-deep: var(--color-gold-soft);
    --diagram-gold: var(--color-gold-soft);
    --diagram-line: rgba(244, 227, 191, 0.28);
    --diagram-surface: rgba(255, 255, 255, 0.08);
    background: linear-gradient(145deg, var(--color-brand-ink), var(--color-brand-deep));
    border-color: rgba(185, 202, 219, 0.28);
  }

  .diagram-frame__header {
    max-width: 48rem;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1.25rem, 5vw, 4rem) 0;
  }

  .diagram-frame__header h2 {
    max-width: 18ch;
    margin: 0;
    color: var(--diagram-ink);
    font-size: var(--font-size-h2);
    line-height: var(--line-height-heading);
  }

  .diagram-frame__header > p:not(.eyebrow) {
    margin: var(--space-4) 0 0;
    color: var(--color-text-soft);
  }

  .diagram-frame--dark .diagram-frame__header > p:not(.eyebrow) { color: var(--color-text-on-dark-soft); }

  .diagram-frame__canvas { padding: clamp(1.5rem, 4vw, 3rem) clamp(1.25rem, 5vw, 4rem) clamp(1.75rem, 5vw, 4rem); }

  @media print {
    .diagram-frame { break-inside: avoid; box-shadow: none; background: white !important; border-color: #9aa7b5; }
    .diagram-frame, .diagram-frame * { color: #071c33 !important; }
  }
</style>
