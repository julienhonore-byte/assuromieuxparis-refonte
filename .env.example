# Valeur par défaut et pour toutes les prévisualisations : indexation bloquée.
PUBLIC_SITE_INDEXABLE=false

# Réserver `true` au contexte Netlify Production après GO signé.
# L'indexation exige simultanément PUBLIC_SITE_INDEXABLE=true et CONTEXT=production.
# Netlify fournit CONTEXT automatiquement ; ne pas le définir manuellement dans
# les Deploy Previews ou les branch deploys.
# Le build n'ouvre alors que les dix routes listées dans le plan d'indexation.

# Architecture de mesure préparée, collecte désactivée par défaut.
# Ne renseigner un identifiant réel qu'après validation du compte GA4, du cadre
# de consentement et des politiques juridiques. Cette variable seule ne charge
# aucun script Google et n'active aucune collecte.
PUBLIC_GA_MEASUREMENT_ID=

# Journalise uniquement les événements normalisés, sans donnée personnelle.
# Laisser false en production ; le mode développement l'active automatiquement.
PUBLIC_ANALYTICS_DEBUG=false
