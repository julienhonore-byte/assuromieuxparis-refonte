---
import ConversionActions from '../components/ConversionActions.astro';
import CoverageMap from '../components/CoverageMap.astro';
import FAQ from '../components/FAQ.astro';
import PageCTA from '../components/PageCTA.astro';
import PageHero from '../components/PageHero.astro';
import ProcessDiagram from '../components/ProcessDiagram.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import RelatedResources from '../components/RelatedResources.astro';
import RiskMap from '../components/RiskMap.astro';
import SectionIllustration from '../components/SectionIllustration.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SolutionMethod from '../components/SolutionMethod.astro';
import TimelineDiagram from '../components/TimelineDiagram.astro';
import TrustBar from '../components/TrustBar.astro';
import WhatWeAnalyze from '../components/WhatWeAnalyze.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { baseSchemas, breadcrumbSchema, pageUrl, serviceSchema } from '../data/seo';
import { prepareVisual } from '../data/visualLibrary';

const path = '/assurance-btp-decennale/';
const description = 'Assurance BTP et décennale : analyse des activités déclarées, attestations, procédés, sous-traitance, véhicules et multirisque.';
const contactHref = '/?besoin=assurance-btp-decennale&intent=quote&product=assurance-btp-decennale#contact';
const ctaLabel = 'Démarrer ma demande de devis Décennale';
const auditHref = '/?besoin=audit-assurances-entreprise&intent=audit&product=assurance-btp-decennale#contact';
const auditLabel = 'Vérifier mes activités et mes contrats';
const btpVisuals = {
  hero: prepareVisual('btp', 'hero-btp-chantier-tertiaire', 'hero'),
  audit: prepareVisual('btp', 'audit-btp-structure-beton', 'audit'),
  method: prepareVisual('btp', 'methode-btp-plans-tablette', 'method'),
  texture: prepareVisual('btp', 'texture-btp-chantier', 'texture'),
};
const btpAnalysisProcess = [
  { label: 'Découverte de l’activité', icon: 'activity' as const },
  { label: 'Identification précise des travaux réalisés', icon: 'search' as const },
  { label: 'Lecture des activités déclarées au contrat', icon: 'document' as const },
  { label: 'Analyse des garanties et exclusions', icon: 'search' as const },
  { label: 'Vérification de la cohérence contrat / activité réelle', icon: 'document' as const },
  { label: 'Consultation du marché', note: 'Si nécessaire', icon: 'market' as const },
  { label: 'Recommandations et accompagnement', icon: 'recommendation' as const },
];
const btpRisks = [
  { label: 'Responsabilité décennale', icon: 'shield' as const },
  { label: 'RC professionnelle', icon: 'shield' as const },
  { label: 'RC exploitation', icon: 'shield' as const },
  { label: 'Dommages en cours de chantier', icon: 'continuity' as const },
  { label: 'Sous-traitance', icon: 'network' as const },
  { label: 'Activités déclarées', icon: 'continuity' as const },
  { label: 'Matériels et locaux', icon: 'goods' as const },
  { label: 'Salariés', icon: 'people' as const },
  { label: 'Véhicules', icon: 'vehicle' as const },
  { label: 'Cyber / continuité', icon: 'cyber' as const },
];
const btpCoverageStages = [
  { label: 'Entreprise' },
  { label: 'Activités réellement exercées' },
  { label: 'Risques' },
  { label: 'Garanties à vérifier', items: ['Décennale', 'RC professionnelle', 'RC exploitation', 'Dommages en cours de chantier', 'Multirisque professionnelle', 'Flotte automobile'] },
  { label: 'Contrats et attestations' },
];
const decennialReviewTimeline = [
  { label: 'Prise de contact', icon: 'activity' as const },
  { label: 'Description des activités', icon: 'people' as const },
  { label: 'Collecte du contrat et de l’attestation', icon: 'document' as const },
  { label: 'Analyse des activités déclarées', icon: 'search' as const },
  { label: 'Vérification des garanties, exclusions et limites', icon: 'search' as const },
  { label: 'Consultation éventuelle du marché', icon: 'market' as const, optional: true },
  { label: 'Restitution et accompagnement', icon: 'support' as const },
];
const faqItems = [
  { question: 'La décennale suffit-elle à couvrir une entreprise du BTP ?', answer: 'Non. Selon l’activité, il faut aussi examiner la RC professionnelle, les locaux, matériels, véhicules, salariés, sous-traitants et conséquences d’une interruption d’activité.' },
  { question: 'Pourquoi vérifier les activités déclarées ?', answer: 'L’attestation et le contrat doivent rester cohérents avec les travaux réellement réalisés. Les libellés, procédés et évolutions d’activité méritent donc une lecture attentive.' },
  { question: 'Quels documents préparer ?', answer: 'Les contrats et attestations, la description des activités, leur part de chiffre d’affaires, les procédés utilisés, l’organisation de la sous-traitance et les principaux types de chantiers.' },
];
const structuredData = [
  ...baseSchemas,
  breadcrumbSchema([{ name: 'Accueil', path: '/' }, { name: 'Assurance BTP et décennale', path }]),
  serviceSchema('Conseil en assurance BTP et décennale', description, path),
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
];
---

<SiteLayout title="Assurance BTP et décennale | Assuromieux Paris" {description} canonical={pageUrl(path)} currentPath={path} ctaHref={contactHref} {ctaLabel} {structuredData}>
  <main id="contenu-principal">
    <PageHero
      eyebrow="Expertise sectorielle"
      title="Relier la décennale aux activités réellement exercées."
      lead="Nous examinons les activités, attestations, procédés et chantiers pour vous aider à repérer les écarts avant une échéance ou une nouvelle opération."
      breadcrumbs={[{ href: '/', label: 'Accueil' }, { label: 'Assurance BTP et décennale' }]}
    >
      <ConversionActions primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} density="hero" analyticsLocation="hero" analyticsSource="btp_hero" />
      <SectionIllustration
        slot="visual"
        image={btpVisuals.hero.image}
        responsive={btpVisuals.hero.responsive}
        alt="Chef de chantier vu de dos devant un bâtiment tertiaire moderne et une grue."
        ratio="16:9"
        width={3200}
        height={1800}
        filename="hero-btp-chantier-tertiaire.webp"
        imageType="Chantier tertiaire, grue et chef de chantier vu de dos"
        priority
        overlay="brand"
        position="58% 48%"
      />
    </PageHero>
    <TrustBar />

    <section class="section" aria-labelledby="public-title">
      <div class="container-wide content-grid">
        <div class="content-copy">
          <p class="eyebrow">À qui s’adresse cette solution ?</p>
          <h2 id="public-title">Aux artisans et entreprises qui réalisent ou coordonnent des travaux.</h2>
        </div>
        <div class="content-copy">
          <p>L’approche concerne les professionnels du bâtiment, les entreprises intervenant sur plusieurs corps d’état et les structures qui font évoluer leurs techniques, leurs marchés ou leur recours à la sous-traitance.</p>
          <p>Une attention particulière est nécessaire lorsque plusieurs activités sont regroupées sous un intitulé général, qu’une prestation accessoire devient régulière ou que les travaux réels ne correspondent plus exactement aux déclarations disponibles.</p>
          <p>Le point de départ reste simple : rapprocher ce qui est déclaré de ce qui est réellement réalisé.</p>
        </div>
      </div>
    </section>

    <section id="risques" class="section section--surface" aria-labelledby="risks-title">
      <div class="container-wide">
        <SectionHeader kicker="Risques couverts" title="Quatre dimensions du programme BTP." id="risks-title" />
        <div class="feature-grid feature-grid--2">
          {[
            ['Décennale et attestations', 'Activités déclarées, période, portée et cohérence avec les travaux.'],
            ['RC professionnelle', 'Responsabilités avant, pendant et autour de la réalisation.'],
            ['Véhicules et matériels', 'Parc, engins, usages, locaux, dépôts et équipements.'],
            ['Entreprise et dirigeant', 'Sous-traitance, équipes, continuité et protection du décideur.'],
          ].map(([title, text]) => <article class="feature-item"><h3>{title}</h3><p>{text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="section" aria-label="Cartographie pédagogique des risques BTP">
      <div class="container-wide">
        <RiskMap title="Les risques d’une entreprise du BTP forment un ensemble." description="Cette cartographie présente les principaux sujets à rapprocher de l’activité de construction, sans présumer de leur caractère obligatoire ni de leur inclusion dans un contrat." center="Entreprise du BTP" risks={btpRisks} />
      </div>
    </section>

    <section class="section" aria-labelledby="checks-title">
      <div class="container-wide content-grid content-grid--reverse">
        <div class="editorial-panel">
          <h2 id="checks-title">Points à vérifier</h2>
          <ul>
            <li>libellés et répartition des activités ;</li>
            <li>procédés et techniques employés ;</li>
            <li>types de chantiers et donneurs d’ordre ;</li>
            <li>organisation de la sous-traitance ;</li>
            <li>attestations et périodes de garantie ;</li>
            <li>véhicules, locaux et matériels.</li>
          </ul>
        </div>
        <div class="content-copy">
          <p class="eyebrow">Un contrôle pragmatique</p>
          <h2>Repérer les écarts avant qu’ils ne deviennent une difficulté.</h2>
          <p>L’audit organise les informations, met en évidence les incohérences et précise les sujets à présenter au marché. Il facilite aussi la mise à jour des attestations et des données d’activité.</p>
          <p class="notice"><strong>Limite importante :</strong> cette analyse ne constitue pas un conseil juridique définitif. Une question de qualification d’activité ou de responsabilité peut nécessiter un professionnel du droit.</p>
        </div>
      </div>
    </section>

    <section class="section section--surface" aria-label="Architecture pédagogique des garanties BTP">
      <div class="container-wide">
        <CoverageMap title="Relier les activités réelles aux contrats et attestations." description="La cohérence entre activité réelle, activité déclarée, garantie et contrat reste le point central ; une attestation décennale ne suffit pas, à elle seule, à établir cette cohérence." stages={btpCoverageStages} />
      </div>
    </section>

    <section class="section section--surface" aria-labelledby="mistakes-title">
      <div class="container-wide">
        <SectionHeader kicker="Erreurs fréquentes" title="Quatre écarts à repérer avant une attestation ou une échéance." id="mistakes-title" />
        <div class="feature-grid feature-grid--2">
          {[
            ['Décrire seulement le métier principal', 'Un intitulé général peut masquer plusieurs travaux, procédés ou rôles. Les activités principales, accessoires et nouvelles doivent être détaillées.'],
            ['Laisser évoluer les travaux sans mise à jour', 'Un nouveau lot, un procédé différent ou une part croissante de sous-traitance peut nécessiter une nouvelle présentation du risque et une validation par l’assureur.'],
            ['Lire l’attestation comme une garantie automatique', 'L’attestation doit être rapprochée du contrat, des périodes, des activités déclarées, des procédés et du chantier concerné.'],
            ['Présumer que la sous-traitance transfère tout le risque', 'Les rôles, engagements contractuels, attestations et recours doivent être examinés au cas par cas, sans conclure à un transfert automatique.'],
          ].map(([title, text]) => <article class="feature-item"><h3>{title}</h3><p>{text}</p></article>)}
        </div>
      </div>
    </section>

    <WhatWeAnalyze />

    <section class="section" aria-label="Méthode d’analyse BTP et décennale en sept étapes">
      <div class="container-wide">
        <ProcessDiagram title="Notre méthode d’analyse BTP et décennale." description="Sept étapes structurent la revue des activités et des contrats. Cette analyse ne vaut ni validation juridique de l’activité ni garantie automatique de couverture." steps={btpAnalysisProcess} />
      </div>
    </section>

    <SolutionMethod title="Une méthode commune, adaptée au BTP." text="Les quatre temps Assuromieux sont appliqués aux activités, attestations et autres contrats du programme. Le suivi accompagne ensuite les évolutions de l’entreprise.">
      <ConversionActions slot="actions" primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} tone="dark" density="compact" analyticsLocation="method" analyticsSource="btp_method" />
    </SolutionMethod>

    <section class="section" aria-label="Déroulement chronologique d’une revue décennale">
      <div class="container-wide">
        <TimelineDiagram title="Le déroulement d’une revue décennale." description="La revue organise les informations disponibles et les points à vérifier, sans se substituer aux décisions de l’assureur ni à une analyse juridique lorsqu’elle est nécessaire." events={decennialReviewTimeline} />
      </div>
    </section>

    <section class="section section--surface" aria-labelledby="faq-title">
      <div class="container faq-layout">
        <SectionHeader kicker="Questions fréquentes" title="Avant de vérifier les contrats BTP." id="faq-title" />
        <FAQ items={faqItems} />
      </div>
    </section>

    <RelatedLinks items={[
      { href: '/audit-assurances-entreprise/', label: 'Audit des assurances', text: 'Découvrir le déroulement de l’analyse.' },
      { href: '/rc-professionnelle/', label: 'RC professionnelle', text: 'Distinguer responsabilité décennale, professionnelle et exploitation.' },
      { href: '/multirisque-professionnelle/', label: 'Multirisque professionnelle', text: 'Relier locaux, matériels et continuité d’activité.' },
      { href: '/flotte-automobile/', label: 'Flotte automobile', text: 'Examiner les véhicules, conducteurs et usages liés aux chantiers.' },
      { href: '/ressources/btp/', label: 'Ressources BTP', text: 'Préparer les activités, attestations, procédés et dates à vérifier.' },
    ]} />
    <RelatedResources items={[
      { href: '/ressources/guides/assurance-decennale-coherence-activites-attestation/', title: 'Décennale : vérifier activités et attestation', description: 'Une méthode prudente pour rapprocher travaux, périodes, procédés et sous-traitance.' },
      { href: '/ressources/guides/comment-auditer-assurances-entreprise/', title: 'Préparer un audit des assurances de l’entreprise', description: 'Rassembler les contrats, les déclarations et les échéances avant de hiérarchiser les vérifications.' },
      { href: '/ressources/guides/rc-professionnelle-rc-exploitation-differences/', title: 'Distinguer RC professionnelle et RC exploitation', description: 'Comprendre comment les activités, les faits et les clauses orientent la lecture des responsabilités.' },
    ]} />
    <PageCTA title="Vérifions la cohérence de vos activités et de vos contrats." text="Un premier échange permet d’identifier les attestations et échéances à examiner en priorité." primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} conversionMode />
  </main>
</SiteLayout>
