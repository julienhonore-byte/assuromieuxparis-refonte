---
import type { NavigationItem } from '../data/site';
import CTA from './CTA.astro';
import DesktopNavigation from './DesktopNavigation.astro';
import MobileNavigation from './MobileNavigation.astro';
import Topbar from './Topbar.astro';

interface Props {
  items: NavigationItem[];
  phoneDisplay: string;
  phoneHref: string;
  email: string;
  orias: string;
  ctaHref?: string;
  ctaLabel?: string;
  currentPath?: string;
}

const {
  items,
  phoneDisplay,
  phoneHref,
  email,
  orias,
  ctaHref = '/#contact',
  ctaLabel = 'Demander un audit gratuit',
  currentPath = '/',
} = Astro.props;
---

<header class="site-header-shell">
  <Topbar {phoneDisplay} {phoneHref} {email} {orias} auditHref={ctaHref} />
  <div class="site-header">
    <div class="container-wide site-header__inner">
      <a class="brand" href="/" aria-label="Assuromieux Paris — Accueil">
        <span class="brand__lockup" data-brand-lockup>
          <img
            src="/logo/assuromieux-paris.jpeg"
            width="300"
            height="83"
            alt="Assuromieux, assurance des professionnels"
            data-brand-logo
          />
          <span class="brand__city">Paris</span>
        </span>
        <span class="brand__fallback" data-brand-fallback hidden>Assuromieux Paris</span>
      </a>
      <DesktopNavigation {items} {currentPath} />
      <div class="site-header__actions">
        <CTA class="site-header__cta" href={ctaHref} label={ctaLabel} showArrow={false} />
        <MobileNavigation {items} {ctaHref} {ctaLabel} {currentPath} />
      </div>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLImageElement>('[data-brand-logo]').forEach((logo) => {
    const brand = logo.closest<HTMLElement>('.brand');
    const fallback = brand?.querySelector<HTMLElement>('[data-brand-fallback]');
    const lockup = logo.closest<HTMLElement>('[data-brand-lockup]');
    if (!fallback) return;

    const showFallback = () => {
      if (lockup) lockup.hidden = true;
      else logo.hidden = true;
      fallback.hidden = false;
    };

    if (logo.complete && logo.naturalWidth === 0) showFallback();
    else logo.addEventListener('error', showFallback, { once: true });
  });
</script>

<style>
  .site-header-shell {
    position: relative;
    z-index: 50;
  }

  .site-header {
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid rgba(185, 202, 219, 0.72);
    backdrop-filter: blur(18px);
  }

  .site-header__inner {
    min-height: 5.25rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2rem);
  }

  .brand {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-brand-deep);
    font-size: 1rem;
    font-weight: var(--font-weight-heading);
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand__lockup {
    display: inline-flex;
    align-items: center;
    gap: clamp(0.5rem, 0.8vw, 0.75rem);
  }

  .brand img {
    width: clamp(9rem, 13vw, 10.5rem);
    height: auto;
  }

  .brand__city {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding-left: clamp(0.5rem, 0.8vw, 0.75rem);
    color: var(--color-brand-deep);
    border-left: 1px solid rgba(11, 39, 71, 0.28);
    font-size: clamp(0.6875rem, 0.64rem + 0.16vw, 0.75rem);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
  }

  .brand__fallback {
    color: var(--color-brand-deep);
    font-size: 1rem;
    font-weight: var(--font-weight-heading);
    line-height: 1.1;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-header__actions :global(.site-header__cta) {
    min-height: 2.875rem;
    padding-inline: 1.25rem;
    font-size: 0.8125rem;
  }

  @media (max-width: 1180px) {
    .site-header__actions :global(.site-header__cta) {
      display: none;
    }
  }

  @media (max-width: 980px) {
    .site-header__inner {
      min-height: 4.75rem;
      display: flex;
      justify-content: space-between;
    }
  }

  @media (max-width: 420px) {
    .brand__lockup {
      gap: 0.4rem;
    }

    .brand img {
      width: clamp(7.75rem, 40vw, 8.75rem);
    }

    .brand__city {
      min-height: 1.25rem;
      padding-left: 0.4rem;
      font-size: 0.625rem;
      letter-spacing: 0.12em;
    }

    .brand__fallback {
      font-size: 0.9375rem;
    }
  }
</style>
