---
import { site, type NavigationItem } from '../data/site';

interface Props {
  phoneDisplay: string;
  phoneHref: string;
  email: string;
  addressStreet: string;
  addressLocality: string;
  addressCountry: string;
  orias: string;
  rcs: string;
  productLinks: NavigationItem[];
  adviceLinks: NavigationItem[];
  auditHref?: string;
  auditLabel?: string;
}

const {
  phoneDisplay,
  phoneHref,
  email,
  addressStreet,
  addressLocality,
  addressCountry,
  orias,
  rcs,
  productLinks,
  adviceLinks,
  auditHref = '/audit-assurances-entreprise/',
  auditLabel = 'Demander un audit gratuit',
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-wide">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <img src="/brand/assuromieux-paris-logo-horizontal-white.svg" width="1200" height="260" alt="Assuromieux Paris" />
        <p>Cabinet de courtage et de conseil en assurances d’entreprise, basé à Paris et présent aux côtés des dirigeants partout en France.</p>
        <a
          class="site-footer__audit"
          href={auditHref}
          data-analytics-event="conversion_start"
          data-analytics-label={auditLabel}
          data-analytics-location="footer"
          data-analytics-source="footer"
        >{auditLabel} <span aria-hidden="true">→</span></a>
      </div>

      <details class="site-footer__group" data-footer-group open>
        <summary>Assurances <span aria-hidden="true">⌄</span></summary>
        <nav aria-label="Assurances">
          <h2>Assurances</h2>
          {productLinks.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </details>

      <details class="site-footer__group" data-footer-group open>
        <summary>Conseil &amp; expertises <span aria-hidden="true">⌄</span></summary>
        <nav aria-label="Conseil et expertises">
          <h2>Conseil &amp; expertises</h2>
          {adviceLinks.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </details>

      <div class="site-footer__contact">
        <h2>Nous contacter</h2>
        <address>
          <span>{addressStreet}</span>
          <span>{addressLocality}</span>
          <span>{addressCountry}</span>
        </address>
        <a href={phoneHref} data-analytics-source="footer">{phoneDisplay}</a>
        <a href={`mailto:${email}`} data-analytics-source="footer">{email}</a>
        <a href={site.oriasUrl} target="_blank" rel="noopener noreferrer">ORIAS {orias}</a>
      </div>
    </div>

    <div class="site-footer__legal">
      <div>
        <strong>Informations réglementaires</strong>
        <p>Site édité par Jules HONORE, entrepreneur individuel exerçant sous le nom commercial ASSUROMIEUX PARIS, {addressStreet}, {addressLocality} ({addressCountry}), SIREN {rcs}, RCS Paris. Courtier d’assurance ou de réassurance (COA) inscrit à l’ORIAS sous le numéro {orias}.</p>
      </div>
      <div>
        <strong>Confidentialité</strong>
        <p>Les données du formulaire sont utilisées pour traiter la demande et transmises via Formspree. Les modalités de traitement et d’exercice des droits sont détaillées dans la politique de confidentialité.</p>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} Assuromieux Paris. Tous droits réservés.</p>
      <div>
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/politique-confidentialite/">Politique de confidentialité</a>
        <a href="/politique-cookies/">Politique Cookies</a>
        <button type="button" data-manage-analytics-consent>Gérer les cookies</button>
        <a href="/politique-editoriale/">Politique éditoriale</a>
        <a href="/conditions-generales-utilisation/">CGU</a>
      </div>
    </div>
  </div>
</footer>

<script>
  const footerGroupMedia = window.matchMedia('(max-width: 640px)');
  const footerGroups = document.querySelectorAll<HTMLDetailsElement>('[data-footer-group]');

  const syncFooterGroups = () => {
    footerGroups.forEach((group) => {
      group.open = !footerGroupMedia.matches;
    });
  };

  footerGroupMedia.addEventListener('change', syncFooterGroups);
  syncFooterGroups();
</script>

<style>
  .site-footer {
    padding-block: clamp(3.5rem, 5.5vw, 5rem) var(--space-6);
    color: var(--color-text-on-dark-soft);
    background:
      radial-gradient(circle at 8% 4%, rgba(201, 154, 70, 0.14), transparent 22%),
      var(--color-brand-ink);
    font-size: var(--font-size-sm);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1.45fr 0.85fr 0.85fr 1fr;
    gap: clamp(2rem, 3.5vw, 3.75rem);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid rgba(217, 227, 238, 0.16);
  }

  .site-footer__brand img {
    width: min(14rem, 100%);
    height: auto;
    margin-bottom: var(--space-4);
  }

  .site-footer__brand p {
    max-width: 25rem;
    margin: 0 0 var(--space-5);
    font-size: 0.9375rem;
  }

  h2,
  strong {
    display: block;
    margin: 0 0 var(--space-4);
    color: var(--color-surface);
    font-size: 0.875rem;
    font-weight: var(--font-weight-heading);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .site-footer__group summary {
    display: none;
  }

  nav,
  .site-footer__contact,
  address {
    display: grid;
    align-content: start;
    gap: var(--space-1);
  }

  address {
    margin-bottom: var(--space-2);
    font-style: normal;
  }

  a {
    min-height: 2rem;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.22em;
  }

  a:hover {
    color: var(--color-gold-soft);
    text-decoration: underline;
  }

  button[data-manage-analytics-consent] {
    min-height: 2rem;
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    font: inherit;
    cursor: pointer;
    text-underline-offset: 0.22em;
  }

  button[data-manage-analytics-consent]:hover {
    color: var(--color-gold-soft);
    text-decoration: underline;
  }

  button[data-manage-analytics-consent]:focus-visible {
    outline: 2px solid var(--color-gold-soft);
    outline-offset: 3px;
  }

  .site-footer__audit {
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    color: var(--color-brand-ink);
    background: var(--color-gold-soft);
    border-radius: var(--radius-control);
    font-weight: var(--font-weight-strong);
    text-decoration: none !important;
  }

  .site-footer__legal {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: var(--space-6);
    padding: var(--space-6);
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(217, 227, 238, 0.1);
    border-radius: var(--radius-card-sm);
  }

  .site-footer__legal p,
  .site-footer__bottom p {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.65;
  }

  .site-footer__bottom,
  .site-footer__bottom div {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .site-footer__bottom {
    justify-content: space-between;
    padding-top: var(--space-6);
    color: rgba(185, 203, 221, 0.86);
  }

  .site-footer__bottom span {
    color: var(--color-gold-soft);
    font-size: var(--font-size-xs);
  }

  @media (max-width: 980px) {
    .site-footer__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    a {
      min-height: 2.75rem;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      padding-bottom: 5.5rem;
    }

    .site-footer__top,
    .site-footer__legal {
      grid-template-columns: 1fr;
    }

    .site-footer__top {
      gap: var(--space-6);
      padding-bottom: var(--space-8);
    }

    .site-footer__group {
      border-block: 1px solid rgba(217, 227, 238, 0.14);
    }

    .site-footer__group + .site-footer__group {
      border-top: 0;
    }

    .site-footer__group summary {
      min-height: 3.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      color: var(--color-surface);
      font-weight: var(--font-weight-heading);
      list-style: none;
      cursor: pointer;
    }

    .site-footer__group summary::-webkit-details-marker {
      display: none;
    }

    .site-footer__group summary span {
      color: var(--color-gold-soft);
      font-size: 1.25rem;
      transition: transform var(--transition-fast);
    }

    .site-footer__group[open] summary span {
      transform: rotate(180deg);
    }

    .site-footer__group nav {
      padding-bottom: var(--space-4);
    }

    .site-footer__group nav h2 {
      display: none;
    }

    .site-footer__legal {
      gap: var(--space-5);
      margin-top: var(--space-5);
      padding: var(--space-5) 0;
      background: transparent;
      border-inline: 0;
      border-radius: 0;
    }

    .site-footer__bottom,
    .site-footer__bottom div {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-2);
    }

  }
</style>
