---
import ConversionActions from '../components/ConversionActions.astro';
import CoverageMap from '../components/CoverageMap.astro';
import FAQ from '../components/FAQ.astro';
import PageCTA from '../components/PageCTA.astro';
import PageHero from '../components/PageHero.astro';
import ProcessDiagram from '../components/ProcessDiagram.astro';
import ProductAudience from '../components/ProductAudience.astro';
import ProductHeroDiagram from '../components/ProductHeroDiagram.astro';
import ProductReview from '../components/ProductReview.astro';
import ProductRiskOverview from '../components/ProductRiskOverview.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import RelatedResources from '../components/RelatedResources.astro';
import RiskMap from '../components/RiskMap.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SolutionMethod from '../components/SolutionMethod.astro';
import TimelineDiagram from '../components/TimelineDiagram.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { baseSchemas, breadcrumbSchema, pageUrl, serviceSchema } from '../data/seo';

const path = '/protection-dirigeant/';
const title = 'Protection du dirigeant d’entreprise | Assuromieux Paris';
const description = 'Protection du dirigeant : analyse de la santé, prévoyance, revenus, homme-clé, frais généraux, responsabilité et continuité de l’entreprise.';
const contactHref = '/?besoin=protection-dirigeant&intent=quote&product=protection-dirigeant#contact';
const ctaLabel = 'Recevoir une étude personnalisée';
const auditHref = '/?besoin=audit-assurances-entreprise&intent=audit&product=protection-dirigeant#contact';
const auditLabel = 'Faire analyser ma protection';
const executiveProtectionAnalysisProcess = [
  { label: 'Analyser le statut', icon: 'activity' as const },
  { label: 'Analyser les revenus', icon: 'search' as const },
  { label: 'Identifier les risques personnels', icon: 'search' as const },
  { label: 'Analyser les contrats existants', icon: 'document' as const },
  { label: 'Formuler des recommandations', icon: 'recommendation' as const },
  { label: 'Consulter le marché si nécessaire', icon: 'market' as const },
];
const executiveProtectionRisks = [
  { label: 'Incapacité', icon: 'continuity' as const },
  { label: 'Invalidité', icon: 'continuity' as const },
  { label: 'Décès', icon: 'continuity' as const },
  { label: 'Perte de revenus', icon: 'shield' as const },
  { label: 'Maintien du niveau de vie', icon: 'shield' as const },
  { label: 'Protection de la famille', icon: 'people' as const },
  { label: 'Continuité de l’entreprise', icon: 'network' as const },
];
const executiveProtectionCoverageStages = [
  { label: 'Statut et situation' },
  { label: 'Revenus et charges' },
  { label: 'Risques à financer' },
  { label: 'Garanties à vérifier', items: ['Prévoyance', 'Garantie décès', 'Incapacité', 'Invalidité', 'Indemnités journalières', 'Rente', 'Garanties complémentaires'] },
  { label: 'Protection du dirigeant' },
];
const executiveProtectionReviewTimeline = [
  { label: 'Découverte', icon: 'activity' as const },
  { label: 'Analyse', icon: 'search' as const },
  { label: 'Comparaison', icon: 'search' as const },
  { label: 'Recommandations', icon: 'recommendation' as const },
  { label: 'Arbitrages', icon: 'market' as const },
  { label: 'Restitution', icon: 'support' as const },
];
const faqItems = [
  { question: 'Quelles protections faut-il étudier pour un dirigeant ?', answer: 'Le périmètre peut inclure santé, prévoyance personnelle, incapacité, invalidité, décès, responsabilité des dirigeants, protection juridique, homme-clé ou frais généraux permanents. Ces solutions ont des objets différents.' },
  { question: 'L’assurance homme-clé protège-t-elle directement le dirigeant ?', answer: 'Son objectif principal est généralement de protéger l’entreprise contre les conséquences financières liées à l’indisponibilité ou au décès d’une personne essentielle, selon le contrat. Elle ne remplace pas la prévoyance personnelle.' },
  { question: 'Pourquoi le statut social du dirigeant est-il important ?', answer: 'Il influence les régimes auxquels le dirigeant est affilié et les prestations existantes. Une analyse du statut, des revenus et de la situation familiale est nécessaire avant d’identifier un besoin complémentaire.' },
  { question: 'Comment estimer le besoin de continuité ?', answer: 'Il faut examiner le rôle opérationnel du dirigeant, les personnes capables de le remplacer, les charges qui continuent, les engagements financiers et le temps nécessaire pour réorganiser l’entreprise.' },
];
const structuredData = [
  ...baseSchemas,
  breadcrumbSchema([{ name: 'Accueil', path: '/' }, { name: 'Assurances entreprises', path: '/assurances-entreprises/' }, { name: 'Protection du dirigeant', path }]),
  serviceSchema('Conseil en protection du dirigeant', description, path),
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
];
---

<SiteLayout {title} {description} canonical={pageUrl(path)} currentPath={path} ctaHref={contactHref} {ctaLabel} {structuredData}>
  <main id="contenu-principal">
    <PageHero
      eyebrow="Protection du dirigeant"
      title="Protéger la personne, les revenus et la continuité autour du dirigeant."
      lead="Nous distinguons les risques personnels du dirigeant de ceux que son indisponibilité peut créer pour l’entreprise."
      breadcrumbs={[{ href: '/', label: 'Accueil' }, { href: '/assurances-entreprises/', label: 'Assurances entreprises' }, { label: 'Protection du dirigeant' }]}
    >
      <ConversionActions primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} density="hero" analyticsLocation="hero" analyticsSource="dirigeant_hero" />
      <ProductHeroDiagram slot="visual" label="Dirigeant" items={['Personne', 'Revenus', 'Responsabilité', 'Continuité']} variant="focus" />
    </PageHero>

    <ProductAudience
      title="Aux dirigeants dont la situation personnelle et le rôle opérationnel méritent une lecture coordonnée"
      paragraphs={[
        'L’analyse de la protection dépend du statut social, des revenus, de la situation familiale et des prestations déjà acquises. Elle dépend aussi de la place du dirigeant dans l’entreprise : production, relation commerciale, financement, signature ou détention d’un savoir difficile à remplacer.',
        'L’analyse est particulièrement utile lors d’un changement de statut, d’une évolution de rémunération, d’un financement, de l’arrivée d’associés ou lorsque l’entreprise repose fortement sur une personne. Elle ne conduit pas à confondre les assurances personnelles avec celles souscrites par l’entreprise.',
      ]}
      markers={['Dirigeants associés', 'Travailleurs non salariés', 'Mandataires sociaux', 'Personnes-clés']}
      variant="aside"
    />

    <ProductRiskOverview
      title="Quatre protections à ne pas confondre"
      intro="La responsabilité du dirigeant, la dépendance de l’entreprise à une personne-clé, la protection de ses revenus et la continuité de l’activité répondent à des besoins distincts."
      items={[
        { title: 'Responsabilité des dirigeants — RCMS', text: 'La responsabilité civile des mandataires sociaux peut intervenir lorsque la responsabilité personnelle d’un dirigeant est recherchée en raison d’une faute de gestion, d’une décision ou d’un manquement commis dans l’exercice de ses fonctions, dans les limites et conditions du contrat. La RCMS ne remplace ni la RC professionnelle de l’entreprise ni la protection juridique.' },
        { title: 'Assurance homme-clé', text: 'Elle vise à protéger l’entreprise contre certaines conséquences financières liées à l’indisponibilité, l’incapacité ou le décès d’une personne essentielle à son activité, selon le contrat. Le bénéficiaire est généralement l’entreprise et le besoin doit être évalué selon la dépendance économique réelle.' },
        { title: 'Protection des revenus du dirigeant', text: 'La prévoyance personnelle vise notamment les conséquences d’un arrêt de travail, d’une invalidité ou d’un décès sur les revenus du dirigeant et la situation de ses proches. Cette protection dépend du statut social, de la rémunération et des garanties déjà existantes.' },
        { title: 'Continuité de l’entreprise', text: 'La disparition ou l’indisponibilité d’un dirigeant peut poser des questions d’organisation, de trésorerie, de transmission, de remboursement d’emprunts ou de maintien de l’activité. Leur traitement exige une analyse individualisée et, selon le sujet, l’intervention de professionnels juridiques ou patrimoniaux compétents.' },
      ]}
      distinction="Ces quatre lectures peuvent se compléter, mais elles ne sont pas interchangeables. Leur portée dépend de la situation, des contrats et des validations spécialisées nécessaires."
      variant="ledger"
    />
    <section class="section" aria-label="Cartographie pédagogique des risques personnels du dirigeant">
      <div class="container-wide">
        <RiskMap title="Cartographier les conséquences personnelles et économiques d’une indisponibilité." description="Cette cartographie présente les principaux risques à examiner sans présumer qu’ils sont tous couverts ou qu’une solution unique peut y répondre." center="Dirigeant" risks={executiveProtectionRisks} />
      </div>
    </section>

    <ProductReview
      checksTitle="Commencer par les conséquences à financer."
      checksIntro="Les capitaux et indemnités n’ont de sens qu’après avoir identifié les revenus, charges, engagements et délais de réorganisation."
      checks={[
        'Le statut social et les régimes auxquels le dirigeant est affilié sont identifiés avec les prestations disponibles.',
        'Les revenus personnels, charges familiales et besoins de protection sont évalués sans extrapolation automatique.',
        'Le rôle du dirigeant dans l’exploitation et les solutions de remplacement sont décrits.',
        'Les charges permanentes, engagements financiers et délais de continuité de l’entreprise sont estimés.',
        'Le bénéficiaire, l’assuré et le souscripteur sont distingués pour chaque solution étudiée.',
        'Définitions de l’incapacité et de l’invalidité, franchises, exclusions et limites d’âge sont vérifiées.',
        'La protection est articulée avec la santé collective, les autres assurances de l’entreprise et la situation patrimoniale à faire valider par les professionnels compétents.',
      ]}
      mistakesTitle="Les confusions qui empêchent une décision claire."
      mistakesIntro="Additionner des contrats ne garantit pas que les besoins personnels et ceux de l’entreprise soient correctement répartis."
      mistakes={[
        { title: 'Assimiler homme-clé et prévoyance', text: 'Le premier vise généralement à protéger l’entreprise ; la seconde concerne la personne et, selon le contrat, ses bénéficiaires. Les objectifs et les personnes concernées doivent être distingués.' },
        { title: 'Partir d’un capital standard', text: 'Le montant utile dépend des revenus, charges, dettes, personnes à protéger et conséquences opérationnelles. Aucun niveau ne peut être fixé sans analyse.' },
        { title: 'Ignorer les prestations existantes', text: 'Les régimes obligatoires, collectifs ou personnels déjà en place doivent être recensés avant d’étudier un complément.' },
        { title: 'Oublier la responsabilité personnelle', text: 'Une mise en cause liée aux décisions de gestion ne relève pas nécessairement de la RC professionnelle de l’entreprise.' },
      ]}
      note={{ title: 'Le dirigeant est souvent le premier actif stratégique de l’entreprise', text: 'Le protéger implique de distinguer sa situation personnelle, sa responsabilité et les conséquences de son absence pour l’organisation. Une même solution ne répond pas à ces trois dimensions.' }}
      variant="stacked"
    />
    <section class="section section--surface" aria-label="Architecture pédagogique des garanties de protection du dirigeant">
      <div class="container-wide">
        <CoverageMap title="Relier les garanties au statut, aux revenus et aux conséquences à financer." description="L’architecture de la protection s’apprécie en rapprochant la situation réelle du dirigeant des définitions, limites et prestations effectivement prévues." stages={executiveProtectionCoverageStages} />
      </div>
    </section>
    <section class="section" aria-label="Méthode d’analyse de la protection du dirigeant">
      <div class="container-wide">
        <ProcessDiagram title="Notre méthode d’analyse de la protection du dirigeant." description="Six étapes structurent l’étude du statut, des revenus, des risques personnels et des contrats avant toute recommandation." steps={executiveProtectionAnalysisProcess} />
      </div>
    </section>

    <SolutionMethod title="Séparer les besoins pour mieux les coordonner." text="Assuromieux inventorie les dispositifs, décrit les conséquences personnelles et professionnelles, puis identifie les écarts. Les sujets sociaux, fiscaux, patrimoniaux ou juridiques sont signalés lorsqu’ils nécessitent une validation spécialisée.">
      <ConversionActions slot="actions" primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} tone="dark" density="compact" analyticsLocation="method" analyticsSource="dirigeant_method" />
    </SolutionMethod>
    <section class="section" aria-label="Déroulement chronologique d’une revue de protection du dirigeant">
      <div class="container-wide">
        <TimelineDiagram title="Le déroulement d’une revue de protection du dirigeant." description="La revue organise la découverte, l’analyse et les arbitrages avant une restitution adaptée aux informations disponibles." events={executiveProtectionReviewTimeline} />
      </div>
    </section>
    <section class="section section--surface" aria-labelledby="faq-title"><div class="container faq-layout"><SectionHeader kicker="Questions fréquentes" title="Avant d’organiser la protection du dirigeant." id="faq-title" /><FAQ items={faqItems} /></div></section>
    <RelatedLinks items={[
      { href: '/sante-prevoyance-entreprise/', label: 'Santé et prévoyance entreprise', text: 'Distinguer la protection collective de la situation du dirigeant.' },
      { href: '/rc-professionnelle/', label: 'RC professionnelle', text: 'Distinguer la responsabilité de l’entreprise de celle du dirigeant.' },
      { href: '/multirisque-professionnelle/', label: 'Multirisque professionnelle', text: 'Relier les biens, les charges et la continuité de l’activité.' },
      { href: '/audit-assurances-entreprise/', label: 'Audit des assurances', text: 'Coordonner protection personnelle et programme d’entreprise.' },
      { href: '/lexique/', label: 'Lexique', text: 'Retrouver les définitions prudentes des principales notions.' },
      { href: '/cyberassurance/', label: 'Continuité des accès et des décisions', text: 'Intégrer les dépendances numériques et l’organisation de crise à la réflexion.' },
      { href: '/assurances-entreprises/', label: 'Programme d’assurances de l’entreprise', text: 'Replacer la protection du dirigeant parmi les autres besoins de l’organisation.' },
    ]} />
    <RelatedResources title="À lire également" items={[
      { href: '/ressources/guides/mutuelle-entreprise-prevoyance-collective-differences/', title: 'Guide pratique de la santé et de la prévoyance collective', description: 'Distinguer les régimes des salariés de la protection personnelle du dirigeant.' },
      { href: '/ressources/guides/comment-auditer-assurances-entreprise/', title: 'Préparer une analyse coordonnée des contrats', description: 'Rassembler les protections existantes et identifier les écarts avant de décider.' },
    ]} />
    <PageCTA title="Que se passerait-il si le dirigeant devait s’arrêter ?" text="Un premier échange permet de distinguer les conséquences pour la personne, la famille et la continuité de l’entreprise." primaryHref={contactHref} primaryLabel={ctaLabel} secondaryHref={auditHref} secondaryLabel={auditLabel} conversionMode />
  </main>
</SiteLayout>
