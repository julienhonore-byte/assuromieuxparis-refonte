---
import { getCollection, render } from 'astro:content';
import ResourceLayout from '../../../layouts/ResourceLayout.astro';
import { baseSchemas, breadcrumbSchema, pageUrl } from '../../../data/seo';
import { resourceCategories, resourcePath } from '../../../data/resources';
import { site } from '../../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('resources', ({ data }) => !data.draft && data.status !== 'archived');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const allEntries = await getCollection('resources', ({ data }) => !data.draft && data.status !== 'archived');
const methodPath = '/ressources/methodes/audit-assurance-transport-optimisation-garanties/';
const transportMethodLinks: Record<string, { href: string; title: string; description: string }[]> = {
  'responsabilite-transporteur-assurance-marchandises-differences': [{
    href: methodPath,
    title: 'Notre méthode pour auditer un programme transport',
    description: 'Relier les flux, responsabilités, véhicules et garanties avant une éventuelle consultation.',
  }],
  'sinistralite-flotte-automobile-indicateurs-prevention': [{
    href: methodPath,
    title: 'Intégrer la sinistralité dans l’audit transport',
    description: 'Replacer les indicateurs de flotte dans l’analyse globale de l’exploitation.',
  }],
  'rc-professionnelle-obligatoire-qui-est-concerne': [{
    href: methodPath,
    title: 'Appliquer la méthode d’audit aux activités de transport',
    description: 'Examiner les responsabilités et les contrats à partir de l’activité réellement exercée.',
  }],
};
const relatedItems = [
  ...entry.data.relatedArticles.map((slug) => allEntries.find((item) => item.data.slug === slug)).filter(Boolean).map((item) => ({
    href: resourcePath(item!.data.slug), title: item!.data.title, description: item!.data.description,
  })),
  ...(transportMethodLinks[entry.data.slug] ?? []),
];
const category = resourceCategories[entry.data.category];
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: entry.data.title,
  description: entry.data.description, datePublished: entry.data.publishDate.toISOString(),
  dateModified: entry.data.updatedDate.toISOString(),
  author: entry.data.articleAuthorType === 'Person' ? {
    '@type': 'Person',
    '@id': `${site.canonicalUrl}#jules-honore`,
    name: site.personName,
    url: site.personUrl,
  } : {
    '@type': 'Organization',
    '@id': `${site.canonicalUrl}#organization`,
    name: entry.data.author,
    url: site.canonicalUrl,
  },
  publisher: { '@id': `${pageUrl('/')}#organization` }, mainEntityOfPage: entry.data.canonical,
  ...(entry.data.status === 'published' && entry.data.reviewedBy ? {
    reviewedBy: {
      '@type': 'Person',
      name: entry.data.reviewedBy,
      ...(entry.data.reviewedBy === site.personName ? {
        '@id': `${site.canonicalUrl}#jules-honore`,
        url: site.personUrl,
      } : {}),
    },
  } : {}),
};
const structuredData = [
  ...baseSchemas,
  breadcrumbSchema([{ name: 'Accueil', path: '/' }, { name: 'Ressources', path: '/ressources/' }, { name: category.name, path: category.href }, { name: entry.data.title, path: resourcePath(entry.data.slug) }]),
  articleSchema,
  ...(entry.data.faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: entry.data.faq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) }] : []),
];
---
<ResourceLayout {...entry.data} headings={headings} {relatedItems} {structuredData}>
  <Content />
</ResourceLayout>
