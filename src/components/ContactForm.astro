---
interface Props {
  action: string;
  calUrl: string;
  privacyHref?: string;
  analyticsContext?: string;
}

const { action, calUrl, privacyHref = '/politique-confidentialite/', analyticsContext = 'audit' } = Astro.props;

interface QualificationField {
  name: string;
  label: string;
  type?: 'text' | 'number' | 'date';
  options?: string[];
  inputmode?: 'numeric' | 'decimal';
  min?: string;
  max?: string;
  placeholder?: string;
  help?: string;
}

interface ProductQualification {
  key: string;
  label: string;
  aliases: string[];
  fields: QualificationField[];
}

const turnoverOptions = [
  'Moins de 250 000 €',
  'De 250 000 € à 1 M€',
  'De 1 M€ à 5 M€',
  'Plus de 5 M€',
  'À préciser',
];

const productQualifications: ProductQualification[] = [
  {
    key: 'transport',
    label: 'Transport',
    aliases: ['assurance-transport', 'transport', 'activite-transport', 'transport-routier', 'convoyage', 'demenagement'],
    fields: [
      { name: 'qualification_transport_activite', label: 'Activité principale', options: ['Transport routier de marchandises', 'Logistique', 'Déménagement', 'Convoyage', 'Transport de personnes', 'Autre'] },
      { name: 'qualification_transport_vehicules', label: 'Nombre de véhicules', type: 'number', inputmode: 'numeric', min: '0', max: '9999', placeholder: 'Ex. : 12' },
      { name: 'qualification_transport_zone', label: 'Zone d’activité principale', options: ['France', 'Europe', 'International', 'À préciser'] },
      { name: 'qualification_transport_contrat', label: 'Contrat actuel', options: ['Oui', 'Non', 'Entreprise en création'] },
      { name: 'qualification_transport_echeance', label: 'Date d’échéance ou d’effet souhaitée', type: 'date' },
    ],
  },
  {
    key: 'decennale',
    label: 'Décennale et BTP',
    aliases: ['assurance-btp-decennale'],
    fields: [
      { name: 'qualification_decennale_activite', label: 'Activité ou métier principal', placeholder: 'Ex. : maçonnerie, électricité…' },
      { name: 'qualification_decennale_ca', label: 'Chiffre d’affaires approximatif', options: turnoverOptions },
      { name: 'qualification_decennale_situation', label: 'Situation actuelle', options: ['Déjà assuré', 'Résilié', 'Entreprise en création', 'Jamais assuré'] },
      { name: 'qualification_decennale_date', label: 'Date d’échéance ou de démarrage souhaitée', type: 'date' },
      { name: 'qualification_decennale_antecedents', label: 'Antécédents ou sinistres', options: ['Non', 'Oui', 'À préciser'] },
    ],
  },
  {
    key: 'flotte',
    label: 'Flotte automobile',
    aliases: ['flotte', 'assurer-flotte-vehicules'],
    fields: [
      { name: 'qualification_flotte_vehicules', label: 'Nombre de véhicules', type: 'number', inputmode: 'numeric', min: '0', max: '9999', placeholder: 'Ex. : 8' },
      { name: 'qualification_flotte_types', label: 'Types de véhicules', placeholder: 'Ex. : utilitaires, poids lourds…' },
      { name: 'qualification_flotte_usages', label: 'Usages principaux', placeholder: 'Ex. : livraisons, déplacements commerciaux…' },
      { name: 'qualification_flotte_sinistralite', label: 'Sinistralité récente', options: ['Faible', 'Moyenne', 'Importante', 'Inconnue'] },
      { name: 'qualification_flotte_echeance', label: 'Date d’échéance du contrat', type: 'date' },
    ],
  },
  {
    key: 'rc-professionnelle',
    label: 'RC professionnelle',
    aliases: ['rc-professionnelle'],
    fields: [
      { name: 'qualification_rc_activite', label: 'Activité principale', placeholder: 'Décrivez votre activité en quelques mots' },
      { name: 'qualification_rc_ca', label: 'Chiffre d’affaires approximatif', options: turnoverOptions },
      { name: 'qualification_rc_salaries', label: 'Nombre de salariés', type: 'number', inputmode: 'numeric', min: '0', max: '99999' },
      { name: 'qualification_rc_reglementee', label: 'Activité réglementée', options: ['Oui', 'Non', 'Incertain'] },
      { name: 'qualification_rc_date', label: 'Date d’effet souhaitée', type: 'date' },
    ],
  },
  {
    key: 'sante-prevoyance',
    label: 'Santé et prévoyance',
    aliases: ['sante-prevoyance'],
    fields: [
      { name: 'qualification_sante_salaries', label: 'Nombre de salariés', type: 'number', inputmode: 'numeric', min: '0', max: '99999' },
      { name: 'qualification_sante_convention', label: 'Convention collective, si connue', placeholder: 'Nom ou identifiant de la convention' },
      { name: 'qualification_sante_besoin', label: 'Type de besoin', options: ['Santé', 'Prévoyance', 'Santé et prévoyance'] },
      { name: 'qualification_sante_population', label: 'Population concernée', options: ['Tous les salariés', 'Cadres', 'Non-cadres', 'Dirigeants', 'À préciser'] },
      { name: 'qualification_sante_echeance', label: 'Date d’échéance ou d’effet souhaitée', type: 'date' },
    ],
  },
  {
    key: 'cyber',
    label: 'Cyberassurance',
    aliases: ['cyber'],
    fields: [
      { name: 'qualification_cyber_salaries', label: 'Nombre de salariés', type: 'number', inputmode: 'numeric', min: '0', max: '99999' },
      { name: 'qualification_cyber_donnees', label: 'Données sensibles traitées', options: ['Oui', 'Non', 'Incertain'] },
      { name: 'qualification_cyber_outils', label: 'Outils ou services critiques', options: ['Oui', 'Non', 'À préciser'] },
      { name: 'qualification_cyber_contrat', label: 'Contrat cyber actuel', options: ['Oui', 'Non', 'Incertain'] },
      { name: 'qualification_cyber_incident', label: 'Incident cyber antérieur', options: ['Non', 'Oui', 'À préciser'] },
    ],
  },
  {
    key: 'multirisque',
    label: 'Multirisque professionnelle',
    aliases: ['multirisque'],
    fields: [
      { name: 'qualification_multirisque_activite', label: 'Activité principale' },
      { name: 'qualification_multirisque_locaux', label: 'Type de locaux', options: ['Bureau', 'Commerce', 'Entrepôt', 'Atelier', 'Autre'] },
      { name: 'qualification_multirisque_surface', label: 'Surface approximative en m²', type: 'number', inputmode: 'decimal', min: '0', max: '999999' },
      { name: 'qualification_multirisque_valeur', label: 'Valeur approximative du matériel ou du stock', options: ['Moins de 50 000 €', 'De 50 000 € à 250 000 €', 'De 250 000 € à 1 M€', 'Plus de 1 M€', 'À préciser'] },
      { name: 'qualification_multirisque_echeance', label: 'Date d’échéance du contrat', type: 'date' },
    ],
  },
  {
    key: 'protection-dirigeant',
    label: 'Protection du dirigeant',
    aliases: ['protection-dirigeant'],
    fields: [
      { name: 'qualification_dirigeant_statut', label: 'Statut du dirigeant', options: ['Travailleur non salarié', 'Assimilé salarié', 'Salarié', 'Autre ou incertain'] },
      { name: 'qualification_dirigeant_nombre', label: 'Nombre de dirigeants concernés', type: 'number', inputmode: 'numeric', min: '1', max: '99' },
      { name: 'qualification_dirigeant_besoin', label: 'Type de besoin', options: ['Prévoyance', 'Santé', 'Homme-clé', 'Responsabilité du dirigeant', 'Protection juridique', 'À préciser'] },
      { name: 'qualification_dirigeant_couverture', label: 'Couverture actuelle', options: ['Oui', 'Non', 'Partielle', 'Incertain'] },
      { name: 'qualification_dirigeant_date', label: 'Date d’effet souhaitée', type: 'date' },
    ],
  },
];

const genericQuoteFields: QualificationField[] = [
  { name: 'qualification_generique_activite', label: 'Activité principale' },
  { name: 'qualification_generique_contrat', label: 'Contrat actuel', options: ['Oui', 'Non', 'Entreprise en création', 'À préciser'] },
  { name: 'qualification_generique_date', label: 'Date d’échéance ou d’effet souhaitée', type: 'date' },
];

const auditFields: QualificationField[] = [
  { name: 'qualification_audit_contrat', label: 'Contrat actuel', options: ['Oui', 'Non', 'Entreprise en création', 'À préciser'] },
  { name: 'qualification_audit_besoin', label: 'Point à analyser en priorité', options: ['Garanties et exclusions', 'Franchises et plafonds', 'Évolution de l’activité', 'Renouvellement ou mise en concurrence', 'Sinistralité', 'Autre point'] },
  { name: 'qualification_audit_echeance', label: 'Prochaine échéance connue', type: 'date' },
];
---

<div class="contact-form-shell">
  <div class="contact-form-context">
    <p class="eyebrow" data-form-kicker>Premier échange</p>
    <h3 data-form-title>Présentez votre besoin.</h3>
    <p data-form-introduction>Ce premier échange sert à comprendre votre activité et à préparer notre retour. Aucun document confidentiel n’est demandé dans ce formulaire.</p>
    <ul class="contact-form-reassurance" aria-label="Repères avant votre demande">
      <li><span aria-hidden="true">✓</span> Première réponse sous 48 h ouvrées</li>
      <li><span aria-hidden="true">✓</span> Sans engagement</li>
      <li><span aria-hidden="true">✓</span> Suivi par votre interlocuteur Assuromieux Paris</li>
      <li><span aria-hidden="true">✓</span> Les informations demandées servent uniquement à préparer notre retour</li>
      <li><span aria-hidden="true">✓</span> Aucun devis définitif sans étude du dossier complet</li>
    </ul>
  </div>

  <div class="contact-process">
    <p class="eyebrow">Après votre demande</p>
    <h3>Comment se déroule la suite&nbsp;?</h3>
    <ol>
      <li><span aria-hidden="true">1</span><p>Vous nous présentez votre besoin.</p></li>
      <li><span aria-hidden="true">2</span><p>Nous analysons votre situation.</p></li>
      <li><span aria-hidden="true">3</span><p>Nous revenons vers vous avec les premières orientations.</p></li>
    </ol>
  </div>

  <form class="contact-form form-grid" {action} method="POST" data-contact-form data-form-context={analyticsContext}>
    <div class="form-field">
      <label for="contact-first-name">Prénom <span aria-hidden="true">*</span></label>
      <input id="contact-first-name" name="prenom" type="text" autocomplete="given-name" required maxlength="100" aria-describedby="contact-required contact-first-name-error" />
      <p class="form-error" id="contact-first-name-error" data-error-for="contact-first-name" hidden></p>
    </div>

    <div class="form-field">
      <label for="contact-last-name">Nom <span aria-hidden="true">*</span></label>
      <input id="contact-last-name" name="nom" type="text" autocomplete="family-name" required maxlength="100" aria-describedby="contact-required contact-last-name-error" />
      <p class="form-error" id="contact-last-name-error" data-error-for="contact-last-name" hidden></p>
    </div>

    <div class="form-field">
      <label for="contact-company">Entreprise <span aria-hidden="true">*</span></label>
      <input id="contact-company" name="entreprise" type="text" autocomplete="organization" required maxlength="160" aria-describedby="contact-required contact-company-error" />
      <p class="form-error" id="contact-company-error" data-error-for="contact-company" hidden></p>
    </div>

    <div class="form-field">
      <label for="contact-email">Email professionnel <span aria-hidden="true">*</span></label>
      <input id="contact-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" aria-describedby="contact-required contact-email-help contact-email-error" />
      <p class="form-help" id="contact-email-help">Exemple : nom@entreprise.fr</p>
      <p class="form-error" id="contact-email-error" data-error-for="contact-email" hidden></p>
    </div>

    <div class="form-field">
      <label for="contact-phone">Téléphone <span data-phone-required aria-hidden="true" hidden>*</span> <span class="label-optional" data-phone-optional>(facultatif)</span></label>
      <input id="contact-phone" name="telephone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" aria-describedby="contact-phone-help contact-phone-error" />
      <p class="form-help" id="contact-phone-help" data-phone-help>Indiquez-le si vous souhaitez être rappelé.</p>
      <p class="form-error" id="contact-phone-error" data-error-for="contact-phone" hidden></p>
    </div>

    <div class="form-field">
      <label for="contact-postal-code">Code postal <span aria-hidden="true">*</span></label>
      <input id="contact-postal-code" name="code_postal" type="text" autocomplete="postal-code" inputmode="numeric" required minlength="3" maxlength="10" pattern="[0-9A-Za-z -]{3,10}" aria-describedby="contact-required contact-postal-code-help contact-postal-code-error" />
      <p class="form-help" id="contact-postal-code-help">Votre zone d’activité principale.</p>
      <p class="form-error" id="contact-postal-code-error" data-error-for="contact-postal-code" hidden></p>
    </div>

    <div class="form-field" data-generic-product-selector>
      <label for="contact-priority">Besoin principal</label>
      <select id="contact-priority" name="contrat_prioritaire">
        <option value="">Je souhaite être conseillé</option>
        <option data-product-slug="comparaison-assurances">Comparaison d’assurances</option>
        <option data-product-slug="creation-reprise">Création ou reprise d’entreprise</option>
        <option data-product-slug="evolution-entreprise">Évolution d’entreprise</option>
        <option data-product-slug="rc-professionnelle">RC professionnelle</option>
        <option data-product-slug="multirisque">Multirisque professionnelle</option>
        <option data-product-slug="flotte" data-product-aliases="assurer-flotte-vehicules">Flotte automobile</option>
        <option data-product-slug="assurance-btp-decennale">Assurance décennale / BTP</option>
        <option data-product-slug="activite-transport">Activité de transport</option>
        <option data-product-slug="assurance-transport" data-product-aliases="transport transport-routier convoyage demenagement">Transport / marchandises</option>
        <option data-product-slug="sante-prevoyance">Santé et prévoyance</option>
        <option data-product-slug="protection-dirigeant">Protection du dirigeant</option>
        <option data-product-slug="cyber">Cyberassurance</option>
        <option data-product-slug="audit-assurances-entreprise" data-product-aliases="audit audit-contrats auditer-mes-assurances">Audit de contrats</option>
        <option>Autre besoin</option>
      </select>
    </div>

    <div class="form-field form-field--full form-field--message">
      <label for="contact-message"><span data-message-label>Message ou précision libre</span> <span data-message-required aria-hidden="true" hidden>*</span></label>
      <textarea id="contact-message" name="message" maxlength="3000" aria-describedby="contact-message-help"></textarea>
      <p class="form-help" id="contact-message-help" data-message-help>Précisez votre contexte ou votre prochaine échéance si vous la connaissez. N'envoyez aucun document confidentiel à cette étape.</p>
      <p class="form-error" id="contact-message-error" data-error-for="contact-message" hidden></p>
    </div>

    <details class="qualification-section form-field--full" data-qualification-group="audit" hidden>
      <summary>Quelques informations pour préparer notre retour</summary>
      <p>Trois repères suffisent à cadrer une première analyse. Vous pourrez préciser votre situation dans le message.</p>
      <div class="qualification-grid">
        {auditFields.map((field) => (
          <div class="form-field">
            <label for={`contact-${field.name}`}>{field.label}</label>
            {field.options ? (
              <select id={`contact-${field.name}`} name={field.name} disabled>
                <option value="">Sélectionner</option>
                {field.options.map((option) => <option>{option}</option>)}
              </select>
            ) : (
              <input
                id={`contact-${field.name}`}
                name={field.name}
                type={field.type ?? 'text'}
                inputmode={field.inputmode}
                min={field.min}
                max={field.max}
                placeholder={field.placeholder}
                disabled
              />
            )}
          </div>
        ))}
      </div>
    </details>

    {productQualifications.map((product) => (
      <details
        class="qualification-section form-field--full"
        data-qualification-group="quote"
        data-product-key={product.key}
        data-product-label={product.label}
        data-product-aliases={product.aliases.join(' ')}
        hidden
      >
        <summary>Quelques informations pour préparer notre retour</summary>
        <p>Ces renseignements facilitent un premier cadrage. Ils ne remplacent pas l’étude complète du dossier.</p>
        <div class="qualification-grid">
          {product.fields.map((field) => (
            <div class="form-field">
              <label for={`contact-${field.name}`}>{field.label}</label>
              {field.options ? (
                <select id={`contact-${field.name}`} name={field.name} disabled>
                  <option value="">Sélectionner</option>
                  {field.options.map((option) => <option>{option}</option>)}
                </select>
              ) : (
                <input
                  id={`contact-${field.name}`}
                  name={field.name}
                  type={field.type ?? 'text'}
                  inputmode={field.inputmode}
                  min={field.min}
                  max={field.max}
                  placeholder={field.placeholder}
                  aria-describedby={field.help ? `contact-${field.name}-help` : undefined}
                  disabled
                />
              )}
              {field.help && <p class="form-help" id={`contact-${field.name}-help`}>{field.help}</p>}
            </div>
          ))}
        </div>
      </details>
    ))}

    <details class="qualification-section form-field--full" data-qualification-group="quote-generic" data-product-label="Assurances d’entreprise" hidden>
      <summary>Quelques informations pour préparer notre retour</summary>
      <p>Ces premiers repères nous aideront à identifier la protection concernée.</p>
      <div class="qualification-grid">
        {genericQuoteFields.map((field) => (
          <div class="form-field">
            <label for={`contact-${field.name}`}>{field.label}</label>
            {field.options ? (
              <select id={`contact-${field.name}`} name={field.name} disabled>
                <option value="">Sélectionner</option>
                {field.options.map((option) => <option>{option}</option>)}
              </select>
            ) : (
              <input id={`contact-${field.name}`} name={field.name} type={field.type ?? 'text'} disabled />
            )}
          </div>
        ))}
      </div>
    </details>

    <div class="form-field visually-hidden" aria-hidden="true">
      <label for="contact-website">Ne pas remplir ce champ</label>
      <input id="contact-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <input type="hidden" name="source" value="Accueil Astro Assuromieux Paris" />
    <input type="hidden" name="campagne" value="Audit assurances entreprise" />
    <input type="hidden" name="intention" value="" data-form-intent />
    <input type="hidden" name="produit" value="" data-form-product />
    <input type="hidden" name="page_origine" value="" data-form-origin-page />
    <input type="hidden" name="libelle_cta" value="" data-form-cta-label />
    <input type="hidden" name="url_provenance" value="" data-form-referrer-url />
    <input type="hidden" name="horodatage" value="" data-form-timestamp />

    <p class="form-note form-field--full" id="contact-required">Les champs signalés par un astérisque sont obligatoires.</p>
    <p class="form-note form-field--full">Les informations transmises servent à traiter votre demande. Consultez notre <a href={privacyHref}>politique de confidentialité</a> avant l’envoi.</p>

    <p class="form-status" role="status" aria-live="polite" data-form-status hidden></p>
    <button class="button button--primary button--large form-field--full" type="submit" data-form-submit>Envoyer ma demande <span aria-hidden="true">→</span></button>
  </form>

  <div class="contact-form-success" data-form-success hidden>
    <p class="eyebrow">Demande reçue</p>
    <h3 tabindex="-1" data-success-heading>Merci, votre demande a bien été envoyée.</h3>
    <p>Nous reviendrons vers vous pour comprendre votre activité, vos contrats et vos prochaines échéances.</p>
    <a
      class="button button--gold button--large"
      href={calUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-analytics-location="form_success"
      data-analytics-source="contact_form"
      data-form-context={analyticsContext}
    >Prendre rendez-vous maintenant <span aria-hidden="true">→</span></a>
  </div>
</div>

<script>
  import { trackAnalyticsEvent } from '../lib/analytics';

  const forms = document.querySelectorAll<HTMLFormElement>('[data-contact-form]');
  const selectedProductKey = 'assuromieux:selected-product';
  const formAttributionKey = 'assuromieux:form-attribution';

  interface FormAttribution {
    ctaLabel?: string;
    originPath?: string;
    originUrl?: string;
    intent?: string;
    product?: string;
  }

  forms.forEach((form) => {
    const submit = form.querySelector<HTMLButtonElement>('[data-form-submit]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const success = form.parentElement?.querySelector<HTMLElement>('[data-form-success]');
    const successHeading = success?.querySelector<HTMLElement>('[data-success-heading]');
    const priority = form.querySelector<HTMLSelectElement>('#contact-priority');
    const intentField = form.querySelector<HTMLInputElement>('[data-form-intent]');
    const productField = form.querySelector<HTMLInputElement>('[data-form-product]');
    const originPageField = form.querySelector<HTMLInputElement>('[data-form-origin-page]');
    const ctaLabelField = form.querySelector<HTMLInputElement>('[data-form-cta-label]');
    const referrerUrlField = form.querySelector<HTMLInputElement>('[data-form-referrer-url]');
    const timestampField = form.querySelector<HTMLInputElement>('[data-form-timestamp]');
    const title = form.parentElement?.querySelector<HTMLElement>('[data-form-title]');
    const kicker = form.parentElement?.querySelector<HTMLElement>('[data-form-kicker]');
    const introduction = form.parentElement?.querySelector<HTMLElement>('[data-form-introduction]');
    const genericProductSelector = form.querySelector<HTMLElement>('[data-generic-product-selector]');
    const phone = form.querySelector<HTMLInputElement>('#contact-phone');
    const phoneRequired = form.querySelector<HTMLElement>('[data-phone-required]');
    const phoneOptional = form.querySelector<HTMLElement>('[data-phone-optional]');
    const phoneHelp = form.querySelector<HTMLElement>('[data-phone-help]');
    const message = form.querySelector<HTMLTextAreaElement>('#contact-message');
    const messageLabel = form.querySelector<HTMLElement>('[data-message-label]');
    const messageRequired = form.querySelector<HTMLElement>('[data-message-required]');
    const messageHelp = form.querySelector<HTMLElement>('[data-message-help]');
    const qualificationGroups = Array.from(form.querySelectorAll<HTMLDetailsElement>('[data-qualification-group]'));
    if (!submit || !status || !success) return;

    const formContext = form.dataset.formContext ?? 'audit';
    const searchParams = new URLSearchParams(window.location.search);
    const requestedIntent = searchParams.get('intent');
    const rawProductContext = searchParams.get('product');
    const requestedProductContext = rawProductContext && /^[a-z0-9-]+$/.test(rawProductContext)
      ? rawProductContext
      : undefined;
    const conversionIntent = requestedIntent === 'quote' || requestedIntent === 'audit'
      ? requestedIntent
      : undefined;

    if (intentField && conversionIntent) intentField.value = conversionIntent;
    if (productField && requestedProductContext) {
      productField.value = requestedProductContext;
    }
    let formStarted = false;
    let validationErrorQueued = false;
    let successTracked = false;

    const selectedServiceInterest = () => productField?.value || priority?.selectedOptions[0]?.dataset.productSlug;

    const findProductGroup = (product: string | undefined) => qualificationGroups.find((group) => {
      if (group.dataset.qualificationGroup !== 'quote') return false;
      const aliases = group.dataset.productAliases?.split(' ') ?? [];
      return aliases.includes(product ?? '');
    });

    const selectedProductGroup = findProductGroup(requestedProductContext);
    const productLabel = selectedProductGroup?.dataset.productLabel ?? 'Assurances d’entreprise';

    qualificationGroups.forEach((group) => {
      group.hidden = true;
      group.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')
        .forEach((field) => { field.disabled = true; });
    });

    const activeQualificationGroup = conversionIntent === 'audit'
      ? qualificationGroups.find((group) => group.dataset.qualificationGroup === 'audit')
      : conversionIntent === 'quote'
        ? selectedProductGroup ?? qualificationGroups.find((group) => group.dataset.qualificationGroup === 'quote-generic')
        : undefined;

    if (activeQualificationGroup) {
      activeQualificationGroup.hidden = false;
      activeQualificationGroup.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')
        .forEach((field) => { field.disabled = false; });
    }

    if (genericProductSelector) {
      genericProductSelector.hidden = Boolean(conversionIntent && requestedProductContext);
    }

    if (conversionIntent === 'quote') {
      if (kicker) kicker.textContent = 'Demande de devis';
      if (title) title.textContent = `Demande de devis — ${productLabel}`;
      if (introduction) introduction.textContent = 'Quelques informations suffisent pour préparer un premier retour. Aucun devis définitif ne peut être établi sans étude du dossier complet.';
      if (phone) {
        phone.required = true;
        phone.setAttribute('aria-describedby', 'contact-required contact-phone-help contact-phone-error');
      }
      if (phoneRequired) phoneRequired.hidden = false;
      if (phoneOptional) phoneOptional.hidden = true;
      if (phoneHelp) phoneHelp.textContent = 'Le numéro auquel vous souhaitez être rappelé.';
    } else if (conversionIntent === 'audit') {
      if (kicker) kicker.textContent = 'Demande d’analyse';
      if (title) title.textContent = `Audit de contrats — ${productLabel}`;
      if (introduction) introduction.textContent = 'Décrivez le point que vous souhaitez faire analyser. Le questionnaire reste volontairement court pour préparer un premier échange.';
      if (message) {
        message.required = true;
        message.setAttribute('aria-describedby', 'contact-required contact-message-help contact-message-error');
      }
      if (messageLabel) messageLabel.textContent = 'Problème rencontré ou besoin d’analyse';
      if (messageRequired) messageRequired.hidden = false;
      if (messageHelp) messageHelp.textContent = 'Indiquez le contrat concerné, la difficulté rencontrée ou la décision à préparer. N’envoyez aucun document confidentiel.';
    }

    let attribution: FormAttribution | undefined;
    try {
      const storedAttribution = window.sessionStorage.getItem(formAttributionKey);
      if (storedAttribution) {
        const parsedAttribution = JSON.parse(storedAttribution) as FormAttribution;
        if (parsedAttribution.intent === conversionIntent && parsedAttribution.product === requestedProductContext) {
          attribution = parsedAttribution;
        }
      }
    } catch {
      // Les champs disposent de valeurs de repli lorsque le stockage est indisponible.
    }

    let safeReferrerUrl = '';
    let safeReferrerPath = '';
    try {
      const referrer = new URL(document.referrer);
      if (referrer.origin === window.location.origin) {
        safeReferrerPath = referrer.pathname;
        safeReferrerUrl = `${referrer.origin}${referrer.pathname}`;
      }
    } catch {
      // Une provenance externe ou absente n'est pas enregistrée dans le formulaire.
    }

    if (originPageField) originPageField.value = attribution?.originPath || safeReferrerPath || window.location.pathname;
    if (ctaLabelField) ctaLabelField.value = attribution?.ctaLabel ?? '';
    if (referrerUrlField) referrerUrlField.value = attribution?.originUrl || safeReferrerUrl || `${window.location.origin}${window.location.pathname}`;
    if (timestampField) timestampField.value = new Date().toISOString();

    const trackFormStart = () => {
      if (formStarted) return;
      formStarted = true;
      trackAnalyticsEvent('form_start', {
        form_context: formContext,
        service_interest: selectedServiceInterest(),
        conversion_intent: conversionIntent,
        source_component: 'contact_form',
      });
    };

    const trackFormView = () => {
      trackAnalyticsEvent('form_view', {
        form_context: formContext,
        service_interest: selectedServiceInterest(),
        conversion_intent: conversionIntent,
        source_component: 'contact_form',
      });
    };

    if ('IntersectionObserver' in window) {
      const formObserver = new IntersectionObserver(
        (entries, observer) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          trackFormView();
          observer.disconnect();
        },
        { threshold: 0.2 },
      );

      formObserver.observe(form);
    } else {
      trackFormView();
    }

    form.addEventListener('input', trackFormStart);
    form.addEventListener('change', trackFormStart);

    if (priority) {
      let requestedProduct = requestedProductContext ?? searchParams.get('besoin');

      if (!requestedProduct) {
        try {
          requestedProduct = window.sessionStorage.getItem(selectedProductKey);
        } catch {
          // Le formulaire reste utilisable lorsque le stockage est indisponible.
        }
      }

      const matchingOption = Array.from(priority.options).find((option) => {
        const aliases = option.dataset.productAliases?.split(' ') ?? [];
        return option.dataset.productSlug === requestedProduct || aliases.includes(requestedProduct ?? '');
      });
      if (matchingOption) {
        priority.value = matchingOption.value;
        if (productField && !productField.value) productField.value = matchingOption.dataset.productSlug ?? '';
      }

      priority.addEventListener('change', () => {
        if (productField) productField.value = selectedServiceInterest() ?? '';
      });
    }

    const setStatus = (message: string, state: 'error' | 'success' | '') => {
      status.textContent = message;
      status.dataset.state = state;
      status.hidden = message.length === 0;
    };

    type FormControl = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

    const setFieldError = (field: FormControl) => {
      const error = form.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`);
      if (!error) return;
      const message = field.validity.valueMissing
        ? 'Ce champ est obligatoire.'
        : field.validity.typeMismatch
          ? 'Saisissez une adresse email valide.'
          : 'Vérifiez la valeur saisie.';
      error.textContent = message;
      error.hidden = false;
      field.setAttribute('aria-invalid', 'true');
    };

    const clearFieldError = (field: FormControl) => {
      const error = form.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`);
      if (!error) return;
      error.textContent = '';
      error.hidden = true;
      field.removeAttribute('aria-invalid');
    };

    form.addEventListener('invalid', (event) => {
      const field = event.target;
      if (!(field instanceof HTMLInputElement) && !(field instanceof HTMLSelectElement) && !(field instanceof HTMLTextAreaElement)) return;
      setFieldError(field);
      setStatus('Certains champs obligatoires sont incomplets ou invalides. Vérifiez les champs signalés.', 'error');

      if (!validationErrorQueued) {
        validationErrorQueued = true;
        trackAnalyticsEvent('audit_form_submit_error', {
          form_context: formContext,
          service_interest: selectedServiceInterest(),
          conversion_intent: conversionIntent,
          error_type: 'validation',
          source_component: 'contact_form',
        });
        trackAnalyticsEvent('form_error', {
          form_context: formContext,
          service_interest: selectedServiceInterest(),
          conversion_intent: conversionIntent,
          error_type: 'validation',
          source_component: 'contact_form',
        });
        window.setTimeout(() => {
          validationErrorQueued = false;
        }, 0);
      }
    }, true);

    form.querySelectorAll<FormControl>('input, select, textarea').forEach((field) => {
      field.addEventListener('input', () => {
        if (field.validity.valid) clearFieldError(field);
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      setStatus('', '');

      if (!form.checkValidity()) {
        Array.from(form.querySelectorAll<FormControl>('input[required], select[required], textarea[required]'))
          .filter((field) => !field.validity.valid)
          .forEach(setFieldError);
        setStatus('Certains champs obligatoires sont incomplets ou invalides. Vérifiez les champs signalés.', 'error');
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }

      const originalLabel = submit.textContent;
      submit.disabled = true;
      submit.textContent = 'Envoi en cours…';
      setStatus('Envoi de votre demande en cours.', '');

      let errorType: 'network' | 'server' | 'unknown' = 'network';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) {
          errorType = 'server';
          throw new Error('Formspree response was not successful.');
        }

        errorType = 'unknown';

        form.hidden = true;
        success.hidden = false;
        successHeading?.focus();

        if (!successTracked) {
          successTracked = true;
          trackAnalyticsEvent('audit_form_submit_success', {
            form_context: formContext,
            service_interest: selectedServiceInterest(),
            conversion_intent: conversionIntent,
            source_component: 'contact_form',
          });
          trackAnalyticsEvent('form_submit', {
            form_context: formContext,
            service_interest: selectedServiceInterest(),
            conversion_intent: conversionIntent,
            source_component: 'contact_form',
          });
        }

        try {
          window.sessionStorage.removeItem(selectedProductKey);
        } catch {
          // Aucun impact sur la confirmation si le stockage est indisponible.
        }
      } catch {
        trackAnalyticsEvent('audit_form_submit_error', {
          form_context: formContext,
          service_interest: selectedServiceInterest(),
          conversion_intent: conversionIntent,
          error_type: errorType,
          source_component: 'contact_form',
        });
        trackAnalyticsEvent('form_error', {
          form_context: formContext,
          service_interest: selectedServiceInterest(),
          conversion_intent: conversionIntent,
          error_type: errorType,
          source_component: 'contact_form',
        });
        setStatus('La demande n’a pas pu être envoyée. Réessayez dans quelques instants ou contactez-nous par téléphone.', 'error');
        submit.disabled = false;
        submit.textContent = originalLabel;
      }
    });
  });
</script>

