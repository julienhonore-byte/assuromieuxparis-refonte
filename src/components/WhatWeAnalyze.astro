---
interface Props {
  title?: string;
}

const { title = 'Ce que nous analysons' } = Astro.props;
const items = ['Garanties', 'Exclusions', 'Franchises', 'Plafonds', 'Responsabilités', 'Activités', 'Échéances', 'Risques'];
---

<section class="analysis-scope section section--compact" aria-label={title}>
  <div class="container-wide analysis-scope__inner">
    <div class="analysis-scope__heading">
      <p class="eyebrow">Lecture des contrats</p>
      <h2>{title}</h2>
    </div>
    <ul class="analysis-scope__list">
      {items.map((item) => (
        <li><span aria-hidden="true">✓</span>{item}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .analysis-scope {
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }

  .analysis-scope__inner {
    display: grid;
    grid-template-columns: minmax(13rem, 0.7fr) minmax(0, 1.3fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4.5rem);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: linear-gradient(135deg, var(--color-surface), var(--color-page-soft));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-card);
  }

  .analysis-scope__heading h2 {
    margin: 0;
    color: var(--color-brand-deep);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: var(--line-height-heading);
  }

  .analysis-scope__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .analysis-scope__list li {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.65rem 0.8rem;
    color: var(--color-text-strong);
    background: var(--color-surface);
    border: 1px solid rgba(185, 202, 219, 0.72);
    border-radius: var(--radius-control);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .analysis-scope__list span {
    color: var(--color-gold-dark);
    font-weight: var(--font-weight-heading);
  }

  @media (max-width: 900px) {
    .analysis-scope__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .analysis-scope__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    .analysis-scope__list {
      grid-template-columns: 1fr;
    }
  }
</style>
