---
type Icon = 'activity' | 'document' | 'search' | 'market' | 'recommendation' | 'support' | 'vehicle' | 'goods' | 'shield' | 'people' | 'network' | 'globe' | 'cyber' | 'continuity';
interface Props { id: string; icon: Icon; label: string; }
const { id, icon, label } = Astro.props;
---

<svg class="diagram-icon" viewBox="0 0 32 32" role="img" aria-labelledby={`diagram-icon-${id}`}>
  <title id={`diagram-icon-${id}`}>{label}</title>
  <desc>Pictogramme représentant {label.toLowerCase()} dans le schéma.</desc>
  {icon === 'document' && <><path d="M9 4h10l5 5v19H9z"/><path d="M19 4v6h5M12 15h9M12 20h9"/></>}
  {icon === 'search' && <><circle cx="14" cy="14" r="8"/><path d="m20 20 7 7M11 14h6M14 11v6"/></>}
  {icon === 'market' && <><path d="M5 27V12l11-7 11 7v15M10 27v-9h12v9M8 12h16"/></>}
  {icon === 'recommendation' && <><path d="m5 17 7 7L27 8"/><path d="M6 7h10M6 12h7"/></>}
  {icon === 'support' && <><circle cx="16" cy="16" r="11"/><path d="M8 16h5l2-5 3 10 2-5h4"/></>}
  {icon === 'vehicle' && <><path d="M5 20h22l-3-8H10zM8 20v5M24 20v5"/><circle cx="10" cy="24" r="2"/><circle cx="22" cy="24" r="2"/></>}
  {icon === 'goods' && <><path d="m6 10 10-5 10 5-10 5zM6 10v12l10 5 10-5V10M16 15v12"/></>}
  {icon === 'shield' && <path d="M16 4 26 8v7c0 7-4 11-10 14C10 26 6 22 6 15V8z"/>}
  {icon === 'people' && <><circle cx="12" cy="11" r="4"/><circle cx="22" cy="13" r="3"/><path d="M4 27c1-7 4-10 8-10s7 3 8 10M19 20c5 0 7 2 8 7"/></>}
  {icon === 'network' && <><circle cx="8" cy="9" r="3"/><circle cx="24" cy="9" r="3"/><circle cx="16" cy="24" r="3"/><path d="m11 10 10 0M10 12l4 9M22 12l-4 9"/></>}
  {icon === 'globe' && <><circle cx="16" cy="16" r="12"/><path d="M4 16h24M16 4c5 5 5 19 0 24M16 4c-5 5-5 19 0 24"/></>}
  {icon === 'cyber' && <><rect x="5" y="7" width="22" height="16" rx="2"/><path d="M11 27h10M16 23v4M10 13l3 3-3 3M16 19h6"/></>}
  {icon === 'continuity' && <><path d="M5 16a11 11 0 0 1 19-7M27 16a11 11 0 0 1-19 7"/><path d="m20 4 4 5-6 1M12 28l-4-5 6-1"/></>}
  {icon === 'activity' && <><path d="M4 22h24M7 22V11h7v11M18 22V6h7v16"/><path d="m6 8 6-4 5 3 9-4"/></>}
</svg>

<style>
  .diagram-icon { width: 1.65rem; height: 1.65rem; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
</style>
