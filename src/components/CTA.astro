---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'gold';
  size?: 'default' | 'large';
  external?: boolean;
  showArrow?: boolean;
  class?: string;
  analyticsLocation?: string;
  analyticsSource?: string;
  serviceInterest?: string;
  conversionIntent?: string;
}

const {
  href,
  label,
  variant = 'primary',
  size = 'default',
  external = false,
  showArrow = true,
  class: className,
  analyticsLocation,
  analyticsSource = 'cta',
  serviceInterest,
  conversionIntent,
} = Astro.props;

const analyticsEvent = href.includes('#contact') ? 'conversion_start' : undefined;
---

<a
  class:list={['button', `button--${variant}`, size === 'large' && 'button--large', className]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-analytics-event={analyticsEvent}
  data-analytics-label={analyticsEvent ? label : undefined}
  data-analytics-location={analyticsLocation}
  data-analytics-source={analyticsEvent ? analyticsSource : undefined}
  data-service-interest={serviceInterest}
  data-conversion-intent={conversionIntent}
>
  <span>{label}</span>
  {showArrow && <span aria-hidden="true">→</span>}
</a>
